<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/colorBackgroundWordListPress" />
            <corners android:topLeftRadius="@dimen/border_radius" android:bottomLeftRadius="@dimen/border_radius" />
        </shape>
    </item>
    <item android:left="@dimen/border_width" android:right="@dimen/border_width" android:top="@dimen/border_width" android:bottom="@dimen/border_width">
        <shape android:shape="rectangle">
            <corners android:topLeftRadius="@dimen/border_radius" android:bottomLeftRadius="@dimen/border_radius" />
            <solid android:color="@color/colorBackgroundWordListPress" />
        </shape>
    </item>
</layer-list>