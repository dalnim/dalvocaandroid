<?xml version="1.0"
    encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <layer-list>
            <item>
                <shape>
                    <gradient android:angle="90"
                        android:endColor="@color/backgroundColor"
                        android:startColor="@color/backgroundColor"
                        android:type="linear" />

                    <stroke android:width="@dimen/border_width"
                        android:color="@color/colorLine" />

                    <corners android:radius="@dimen/border_radius" />

                    <padding android:bottom="@dimen/border_radius"
                        android:left="@dimen/border_radius"
                        android:right="@dimen/border_radius"
                        android:top="@dimen/border_radius" />
                </shape>
            </item>
            <item>
                <bitmap android:gravity="center|right"
                    android:src="@mipmap/ic_arrow_gray_small" />
            </item>
        </layer-list>
    </item>
</selector>