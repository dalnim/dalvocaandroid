<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/llScrollableMenu"
    android:layout_width="@dimen/scrollable_menu_item_width"
    android:layout_height="wrap_content"
    android:gravity="center_horizontal"
    android:orientation="vertical">

    <ImageView
        android:id="@+id/imgIcon"
        android:layout_width="@dimen/scrollable_menu_icon_size"
        android:layout_height="@dimen/scrollable_menu_icon_size"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="5dp"
        android:background="@drawable/bg_scrollale_menu_icon_selector"
        tools:src="@drawable/ic_subtitle_group" />

    <TextView
        android:id="@+id/tvMenuName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="2"
        android:lines="2"
        android:shadowColor="@color/black"
        android:shadowRadius="1"
        android:shadowDx="1"
        android:shadowDy="1"
        android:textColor="@color/textDayWhiteNightLightWhiteColor"
        android:textSize="12sp"
        android:visibility="invisible"
        tools:visibility="visible"
        tools:text="name"/>
</LinearLayout>