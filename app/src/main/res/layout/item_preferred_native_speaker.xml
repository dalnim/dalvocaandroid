<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/v_container"
    style="@style/WidthMatch">

    <LinearLayout
        android:id="@+id/v_background"
        style="@style/HeightMatch"
        android:layout_alignParentEnd="true"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tv_delete"
            android:layout_width="85dp"
            android:layout_height="match_parent"
            android:background="@color/colorRed"
            android:gravity="center"
            android:text="@string/reading_list_item_delete"
            android:textColor="@color/textDeleteOnRedBackgroundColor"
            android:textSize="16sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/v_foreground"
        style="@style/ItemBase"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="@dimen/item_padding_left_right"
        android:paddingTop="@dimen/item_padding_top_bottom"
        android:paddingBottom="@dimen/item_padding_top_bottom">

        <ImageView
            android:id="@+id/ic_avatar"
            android:layout_width="48dp"
            android:layout_height="48dp" />

        <LinearLayout
            android:id="@+id/ll_username_desc"
            style="@style/FillRemainHorizontal"
            android:layout_marginLeft="@dimen/item_padding_left_right"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_primary"
                style="@style/TextViewItem"
                android:textColor="@color/textPrimaryColor"
                tools:text="name"/>

            <TextView
                android:id="@+id/tv_secondary"
                style="@style/TextViewItem"
                android:layout_marginTop="@dimen/word_meaning_margin_top"
                android:textColor="@color/textPrimaryColor"
                tools:text="record count"/>
        </LinearLayout>

        <ImageView
            android:id="@+id/ic_play"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="center_vertical"
            android:padding="8dp"
            android:src="@drawable/ic_volume_up_outline_48dp" />

        <ImageView
            android:id="@+id/ic_drag"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="center_vertical"
            android:padding="16dp"
            android:src="@drawable/ic_drawer_menu"
            app:tint="@color/textPrimaryColor" />

        <ImageView
            android:id="@+id/ic_check"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="center_vertical"
            android:padding="12dp"
            android:src="@drawable/ic_checkbox_1_checked" />
    </LinearLayout>
</RelativeLayout>
