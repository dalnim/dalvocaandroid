<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/ViewBase"
    android:orientation="vertical">

    <com.dalread.component.Toolbar
        android:id="@id/header"
        style="@style/WidthMatch"
        app:title="@string/profile"
        app:leftIcon="@drawable/ic_back"
        app:rightText="@string/edit" />

    <ScrollView style="@style/Match">

        <LinearLayout
            style="@style/WidthMatch"
            android:orientation="vertical">

            <LinearLayout
                style="@style/WidthMatch"
                android:background="@color/backgroundColor"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/iv_avatar"
                    android:layout_width="90dp"
                    android:layout_height="90dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="32dp" />

                <ImageView
                    android:id="@+id/iv_introduction"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="16dp"
                    android:src="@drawable/ic_mic_none_black_24dp" />

                <TextView
                    android:id="@+id/tv_name"
                    style="@style/Wrap"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="16dp"
                    android:textSize="32sp"
                    android:textStyle="bold" />

                <LinearLayout
                    style="@style/WidthMatch"
                    android:layout_marginTop="4dp"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <ImageView
                        style="@style/Wrap"
                        android:src="@drawable/ic_location_on_black_24dp"
                        app:tint="@color/color_location_icon" />

                    <TextView
                        android:id="@+id/tv_location"
                        style="@style/Wrap"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginStart="16dp"
                        android:textSize="20sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tv_join_date"
                    style="@style/Wrap"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="12dp"
                    android:textSize="12sp" />

                <LinearLayout
                    style="@style/WidthMatch"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="12dp"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center_horizontal"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tv_score"
                            style="@style/Wrap"
                            android:textSize="16sp" />

                        <TextView
                            style="@style/Wrap"
                            android:text="@string/score"
                            android:textSize="16sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center_horizontal"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tv_following_count"
                            style="@style/Wrap"
                            android:textSize="16sp" />

                        <TextView
                            style="@style/Wrap"
                            android:text="@string/following"
                            android:textSize="16sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center_horizontal"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tv_follower_count"
                            style="@style/Wrap"
                            android:textSize="16sp" />

                        <TextView
                            style="@style/Wrap"
                            android:text="@string/follower"
                            android:textSize="16sp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/v_bio"
                style="@style/ItemSetting">

                <TextView
                    android:id="@+id/tv_bio"
                    style="@style/TextViewSettingLabel"
                    android:ellipsize="end"
                    android:maxLines="2"
                    tools:text="bio"/>

                <ImageView
                    style="@style/Wrap"
                    android:layout_gravity="center_vertical"
                    android:src="@drawable/ic_keyboard_arrow_right_36dp" />
            </LinearLayout>

            <View style="@style/Divider" />

            <LinearLayout
                android:id="@+id/v_following"
                style="@style/ItemSetting">

                <TextView
                    style="@style/TextViewSettingLabel"
                    android:text="@string/following" />

                <ImageView
                    style="@style/Wrap"
                    android:layout_gravity="center_vertical"
                    android:src="@drawable/ic_keyboard_arrow_right_36dp" />
            </LinearLayout>

            <View style="@style/Divider" />

            <LinearLayout
                android:id="@+id/v_follower"
                style="@style/ItemSetting">

                <TextView
                    style="@style/TextViewSettingLabel"
                    android:text="@string/follower" />

                <ImageView
                    style="@style/Wrap"
                    android:layout_gravity="center_vertical"
                    android:src="@drawable/ic_keyboard_arrow_right_36dp" />
            </LinearLayout>

            <View style="@style/Divider" />

            <LinearLayout
                android:id="@+id/v_favorite"
                style="@style/ItemSetting">

                <TextView
                    style="@style/TextViewSettingLabel"
                    android:text="@string/favorite_users" />

                <ImageView
                    style="@style/Wrap"
                    android:layout_gravity="center_vertical"
                    android:src="@drawable/ic_keyboard_arrow_right_36dp" />
            </LinearLayout>

            <View style="@style/Divider" />

            <LinearLayout
                android:id="@+id/v_block"
                style="@style/ItemSetting">

                <TextView
                    style="@style/TextViewSettingLabel"
                    android:text="@string/block_users" />

                <ImageView
                    style="@style/Wrap"
                    android:layout_gravity="center_vertical"
                    android:src="@drawable/ic_keyboard_arrow_right_36dp" />
            </LinearLayout>

            <View style="@style/Divider" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
