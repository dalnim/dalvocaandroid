<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/Layout_Padding"
    android:background="@android:color/transparent">

    <LinearLayout
        style="@style/Layout_Dialog"
        android:layout_centerInParent="true"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_title"
            style="@style/TextView_Header"
            android:layout_gravity="center"
            android:layout_marginTop="@dimen/activity_vertical_margin"
            android:gravity="center"
            android:maxLines="5"
            android:text="@string/title_select_range" />

<!--        <TextView-->
<!--            android:id="@+id/tv_description"-->
<!--            style="@style/TextView_Description"-->
<!--            android:layout_gravity="center"-->
<!--            android:layout_marginTop="@dimen/activity_vertical_margin"-->
<!--            android:gravity="center"-->
<!--            android:text="@string/select_range_title" />-->

        <EditText
            android:id="@+id/et_from"
            style="@style/EditText_Main"
            android:layout_marginStart="16dp"
            android:layout_marginTop="@dimen/activity_vertical_margin"
            android:layout_marginEnd="16dp"
            android:background="@drawable/background_edittext"
            android:hint="@string/range_from"
            android:imeOptions="actionNext"
            android:inputType="numberDecimal"
            android:textColor="@color/colorBlack"
            android:textColorHint="@color/color_text" />

        <EditText
            android:id="@+id/et_to"
            style="@style/EditText_Main"
            android:layout_marginStart="16dp"
            android:layout_marginTop="@dimen/activity_vertical_margin"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="@dimen/activity_vertical_margin"
            android:background="@drawable/background_edittext"
            android:hint="@string/range_to"
            android:imeOptions="actionDone"
            android:inputType="numberDecimal"
            android:textColor="@color/colorBlack"
            android:textColorHint="@color/color_text" />

        <include layout="@layout/layout_line_horizontal" />

        <LinearLayout
            style="@style/WidthMatch"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btn_positive"
                style="@style/Button_Base"
                android:layout_weight="1"
                android:text="@string/ok"
                android:textColor="@drawable/btn_ok_color" />

            <include layout="@layout/layout_line_vertical" />

            <TextView
                android:id="@+id/btn_negative"
                style="@style/Button_Base"
                android:layout_weight="1"
                android:text="@string/cancel"
                android:textColor="@color/colorRed" />
        </LinearLayout>
    </LinearLayout>
</RelativeLayout>