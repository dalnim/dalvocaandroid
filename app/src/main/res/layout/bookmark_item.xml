<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rel_main"
    android:layout_width="match_parent"
    android:layout_height="70dp"
    android:orientation="vertical">

    <com.daimajia.swipe.SwipeLayout xmlns:swipe="http://schemas.android.com/apk/res-auto"
        android:id="@+id/swipe"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        swipe:leftEdgeSwipeOffset="0dp"
        swipe:rightEdgeSwipeOffset="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:background="#FF5534"
            android:gravity="center"
            android:tag="Bottom3"
            android:weightSum="10">

            <ImageView
                android:id="@+id/trash"
                android:layout_width="27dp"
                android:layout_height="30dp"
                android:layout_weight="1"
                android:src="@mipmap/ic_bm_delete" />

            <TextView
                android:id="@+id/text_dlt"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="5"
                android:text="Delete File?"
                android:textColor="#fff"
                android:textSize="17sp" />

            <Button
                android:id="@+id/delete"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="4"
                android:background="#ffffff"
                android:text="Yes,Delete"
                android:textColor="#FF5534" />
        </LinearLayout>

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:id="@+id/rowBG"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentRight="true"
                android:gravity="right"
                android:orientation="horizontal">

                <RelativeLayout
                    android:id="@+id/rlDelete"
                    android:layout_width="@dimen/size_reading_list"
                    android:layout_height="match_parent"
                    android:background="@color/colorRed"
                    android:clickable="true"
                    android:focusable="true"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_centerInParent="true"
                        android:background="?android:selectableItemBackground"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="@dimen/size_reading_list"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:padding="@dimen/activity_vertical_margin_item"
                            android:text="@string/reading_list_item_delete"
                            android:textColor="@color/colorWhite"
                            android:textSize="17sp" />
                    </LinearLayout>
                </RelativeLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/rowFG"
                style="@style/Match"
                android:background="@android:color/white"
                android:clickable="true"
                android:focusable="true"
                android:orientation="vertical"
                android:visibility="visible">

                <LinearLayout
                    android:id="@+id/main_lin"
                    style="@style/WidthMatch"
                    android:background="@color/colorWhite"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:padding="@dimen/activity_vertical_margin_item">

                    <RelativeLayout
                        android:layout_width="wrap_content"
                        android:layout_height="60dp"
                        android:layout_marginRight="@dimen/activity_vertical_margin_item">

                        <de.hdodenhof.circleimageview.CircleImageView
                            android:id="@+id/ivType"
                            style="@style/ImageView_MovieList"
                            android:layout_centerHorizontal="true"
                            android:layout_centerVertical="true"
                            android:background="@drawable/circular_background"
                            android:padding="1dp"
                            android:src="@drawable/ic_app_cn" />

                    </RelativeLayout>

                    <LinearLayout
                        style="@style/WidthMatch"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvTitle"
                            style="@style/TextView_ReadingList_Title"
                            android:text="dbvbdbfhdbfbvdbfbdfbvjhdbfbdfbvdbfjhdbfhbdfbdhbfhjdbfhbdhfbhjdbfhvbdhfbdfbvhjdbf.mp4" />

                        <LinearLayout
                            style="@style/WidthMatch"
                            android:layout_height="wrap_content"
                            android:weightSum="3">

                            <TextView
                                android:id="@+id/time_period"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="0.4-0.6" />
                        </LinearLayout>
                    </LinearLayout>
                    <!--<ImageView-->
                    <!--android:id="@+id/idArrow"-->
                    <!--style="@style/ImageView_Item_Movie"-->
                    <!--android:layout_marginLeft="@dimen/activity_vertical_margin_item"-->
                    <!--android:layout_marginRight="@dimen/activity_vertical_margin_item"-->
                    <!--android:src="@mipmap/ic_right" />-->
                </LinearLayout>
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_alignParentBottom="true"
                android:background="#30000000" />
        </RelativeLayout>
    </com.daimajia.swipe.SwipeLayout>
</RelativeLayout>