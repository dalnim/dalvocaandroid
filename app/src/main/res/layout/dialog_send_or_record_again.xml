<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/WidthMatch"
    android:background="@color/color_play_background">

    <ImageView
        android:id="@+id/ic_close"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:padding="4dp"
        android:src="@drawable/ic_close_black_24dp" />

    <TextView
        android:id="@+id/tv_header"
        style="@style/TextViewItem"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="16dp"
        android:gravity="center_horizontal"
        android:text="@string/send_or_record_again"
        android:textColor="@color/colorBlack" />

    <ImageView
        android:id="@+id/ivSpeaker"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_below="@id/tv_header"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp"
        android:padding="4dp"
        android:src="@drawable/ic_volume_up_48dp" />

    <ImageView
        android:id="@+id/ivMic"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_alignTop="@id/ivSpeaker"
        android:layout_centerHorizontal="true"
        android:padding="4dp"
        android:src="@drawable/ic_mic_none_black_24dp"
        app:tint="@color/color_black_speaker_icon" />

    <TextView
        android:id="@+id/tv_recording"
        style="@style/TextViewSubItem"
        android:layout_below="@id/ivMic"
        android:layout_centerHorizontal="true"
        android:gravity="center_horizontal"
        android:padding="4dp"
        android:text="@string/recording_tap_to_stop"
        android:textColor="@color/colorBlack"
        android:visibility="invisible" />

    <Button
        android:id="@+id/btn_send"
        style="@style/ButtonBlue"
        android:layout_alignBottom="@id/ivSpeaker"
        android:layout_alignParentEnd="true"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="12dp"
        android:text="@string/send" />
</RelativeLayout>
