<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/v_item"
    style="@style/ItemBase"
    android:background="@color/backgroundColor"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    >

    <LinearLayout
        style="@style/WidthMatch"
        android:orientation="vertical"
        android:padding="0dp">
        <LinearLayout
            android:id="@+id/llSearch"
            style="@style/WidthMatch"
            android:orientation="horizontal"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="4dp"
            >
            <EditText
                android:id="@+id/etSearchKeyword"
                style="@style/WidthMatch"
                android:textColor="@color/textPrimaryColor"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"
                android:layout_weight="1"
                android:layout_gravity="center"
                android:imeOptions="actionSearch"
                android:singleLine="true"
                android:hint="@string/search_in_dictionary"
                android:backgroundTint="@color/backgroundGrayColor"/>
            <Button
                android:id="@+id/btnResetSearch"
                style="@style/ButtonBlue"
                android:textColor="@color/textPrimaryWhiteColor"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="2dp"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"
                android:text="@string/init_search_keyword_result" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
