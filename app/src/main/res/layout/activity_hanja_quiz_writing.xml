<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/ViewBase"
    android:orientation="vertical">

    <com.dalread.component.Toolbar
        android:id="@id/header"
        style="@style/WidthMatch"
        app:leftIcon="@drawable/ic_back"
        app:title="@string/tb_quiz" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/color_stop"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingLeft="16dp"
        android:paddingTop="4dp"
        android:paddingRight="16dp"
        android:paddingBottom="4dp">

        <TextView
            android:id="@+id/tv_all_words_count"
            style="@style/TextViewHeader"
            android:textColor="@color/colorWhite" />

        <TextView
            android:id="@+id/tv_last_word"
            style="@style/TextViewHeader"
            android:layout_marginTop="4dp"
            android:textColor="@color/colorWhite" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/color_header_background"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="16dp"
        android:paddingTop="4dp"
        android:paddingRight="16dp"
        android:paddingBottom="4dp">

        <LinearLayout
            android:id="@+id/v_wrong"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <TextView
                style="@style/TextViewHeader"
                android:text="@string/wrong"
                android:textColor="@color/colorBlack" />

            <TextView
                android:id="@+id/tv_wrong_count"
                style="@style/TextViewHeader"
                android:textColor="@color/colorBlack" />
        </LinearLayout>

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/tv_character_count"
            style="@style/Wrap"
            android:textColor="@color/colorBlack"
            android:textSize="22sp" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <LinearLayout
            android:id="@+id/v_correct"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <TextView
                style="@style/TextViewHeader"
                android:text="@string/correct"
                android:textColor="@color/colorBlack" />

            <TextView
                android:id="@+id/tv_correct_count"
                style="@style/TextViewHeader"
                android:textColor="@color/colorBlack" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/tv_practice_index"
        style="@style/TextViewHeader"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="8dp"
        android:textColor="@color/colorBlack" />

    <TextView
        android:id="@+id/tv_parent_voca"
        style="@style/Wrap"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="12dp"
        android:textSize="@dimen/test_question_text_size" />

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/ic_visible"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_centerHorizontal="true"
            android:src="@drawable/ic_visibility_black_24dp" />

        <ImageView
            android:id="@+id/ic_undo"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_alignTop="@id/ic_visible"
            android:layout_marginEnd="80dp"
            android:layout_toStartOf="@id/ic_visible"
            android:src="@drawable/ic_undo_black_24dp" />

        <ImageView
            android:id="@+id/ic_refresh"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_alignTop="@id/ic_visible"
            android:layout_marginStart="80dp"
            android:layout_toEndOf="@id/ic_visible"
            android:src="@drawable/ic_refresh_black_24dp" />
    </RelativeLayout>

    <ProgressBar
        android:id="@+id/pb_time"
        style="@android:style/Widget.ProgressBar.Horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="32dp"
        android:layout_marginTop="8dp"
        android:layout_marginRight="32dp"
        android:minHeight="6dp"
        android:progressBackgroundTint="@color/color_stop"
        android:progressTint="@color/colorBlue" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginLeft="32dp"
        android:layout_marginTop="16dp"
        android:layout_marginRight="32dp"
        android:layout_marginBottom="16dp"
        android:layout_weight="1">

        <WebView
            android:id="@+id/wv_hanzi_writer"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/btn_black_border_white_background" />
    </FrameLayout>

    <TextView
        android:id="@+id/tv_meaning"
        style="@style/Wrap"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp"
        android:textColor="@color/colorBlack"
        android:textSize="@dimen/test_question_text_size" />
</LinearLayout>
