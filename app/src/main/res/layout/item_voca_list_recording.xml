<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/ItemBase"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:background="@color/backgroundCellColor"
    android:paddingTop="@dimen/item_padding_top_bottom"
    android:paddingBottom="@dimen/item_padding_top_bottom">

    <LinearLayout
        style="@style/WidthMatch"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvVoca"
            style="@style/Textview_Voca"
            tools:text="Voca"/>

        <TextView
            android:id="@+id/tvMeaning"
            style="@style/Textview_Meaning"
            android:layout_marginTop="12dp"
            tools:text="Meaning"/>
    </LinearLayout>

    <RelativeLayout
        style="@style/WidthMatch"
        android:layout_marginTop="5dp"
        android:padding="0dp">

        <TextView
            android:id="@+id/tv_index"
            style="@style/TextViewSubItem"
            android:layout_marginTop="5dp"
            android:layout_marginStart="5dp"
            android:layout_gravity="center"
            android:layout_alignParentStart="true"
            android:text="1"/>


        <ImageView
            android:id="@+id/ivMic"
            style="@style/ImageView_Player_Circle_No_Margin"
            android:gravity="center"
            android:layout_toRightOf="@+id/tv_index"
            android:layout_centerInParent="true"
            android:layout_marginLeft="10dp"
            android:src="@drawable/ic_mic_none_black_24dp" />


        <ImageView
            android:id="@+id/ivSpeaker"
            style="@style/ImageView_Player_Circle_No_Margin"
            android:layout_centerInParent="true"
            android:src="@drawable/ic_volume_up_48dp" />

        <!--        </LinearLayout>-->


    </RelativeLayout>
</LinearLayout>
