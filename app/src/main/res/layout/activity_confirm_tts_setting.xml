<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/Layout_Padding"
    android:background="@android:color/transparent">

    <LinearLayout
        style="@style/Layout_Dialog"
        android:layout_centerInParent="true"
        android:orientation="vertical">

        <TextView
            style="@style/TextView_Header"
            android:layout_gravity="center"
            android:layout_marginBottom="@dimen/activity_horizontal_margin_item"
            android:layout_marginTop="@dimen/activity_vertical_margin"
            android:gravity="center"
            android:text="@string/tts_title" />

        <TextView
            style="@style/TextView_Title"
            android:layout_gravity="center"
            android:layout_marginBottom="@dimen/activity_horizontal_margin"
            android:gravity="center"
            android:text="@string/error_msg_tts_not_supported" />

        <include layout="@layout/layout_line_horizontal" />

        <LinearLayout
            style="@style/WidthMatch"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnOpenSetting"
                style="@style/Button_Base"
                android:layout_weight="1"
                android:text="@string/tts_open_setting"
                android:textColor="@drawable/btn_ok_color" />

            <include layout="@layout/layout_line_vertical" />

            <TextView
                android:id="@+id/btnCancel"
                style="@style/Button_Base"
                android:layout_weight="1"
                android:text="@string/tts_cancel"
                android:textColor="@color/colorRed" />
        </LinearLayout>
    </LinearLayout>
</RelativeLayout>