<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/Layout_Padding"
    android:background="@android:color/transparent">

    <LinearLayout
        style="@style/Layout_Dialog"
        android:layout_gravity="center"
        android:orientation="vertical">

        <LinearLayout
            style="@style/WidthMatch"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="20dp"
            android:orientation="vertical">

            <TextView
                style="@style/Popup_Header_Text"
                android:text="@string/change_password_title"
                android:textColor="@color/primaryColor" />

            <TextView style="@style/Popup_Header_Marker" />
        </LinearLayout>

        <include layout="@layout/layout_line_horizontal" />

        <ScrollView
            style="@style/Match"
            android:paddingVertical="2dp">

            <LinearLayout
                style="@style/WidthMatch"
                android:orientation="vertical">

                <EditText
                    android:id="@+id/etMail"
                    style="@style/EditText_Main"
                    android:layout_marginLeft="@dimen/activity_vertical_margin"
                    android:layout_marginTop="20dp"
                    android:layout_marginRight="@dimen/activity_vertical_margin"
                    android:layout_marginBottom="5dp"
                    android:background="@drawable/background_edittext_center_round"
                    android:hint="@string/sign_up_id_mail"
                    android:imeOptions="actionNext"
                    android:inputType="textEmailAddress" />

                <EditText
                    android:id="@+id/etCurrentPassword"
                    style="@style/EditText_PassWord"
                    android:layout_marginLeft="@dimen/activity_vertical_margin"
                    android:layout_marginTop="5dp"
                    android:layout_marginRight="@dimen/activity_vertical_margin"
                    android:layout_marginBottom="5dp"

                    android:background="@drawable/background_edittext_center_round"
                    android:hint="@string/change_password_current_password"
                    android:imeOptions="actionNext" />

                <EditText
                    android:id="@+id/etNewPassword"
                    style="@style/EditText_PassWord"
                    android:layout_marginLeft="@dimen/activity_vertical_margin"
                    android:layout_marginTop="5dp"
                    android:layout_marginRight="@dimen/activity_vertical_margin"
                    android:layout_marginBottom="5dp"

                    android:background="@drawable/background_edittext_center_round"
                    android:hint="@string/change_password_new_password"
                    android:imeOptions="actionNext" />

                <EditText
                    android:id="@+id/etRetypePassword"
                    style="@style/EditText_PassWord"
                    android:layout_marginLeft="@dimen/activity_vertical_margin"
                    android:layout_marginTop="5dp"
                    android:layout_marginRight="@dimen/activity_vertical_margin"
                    android:layout_marginBottom="20dp"

                    android:background="@drawable/background_edittext_center_round"
                    android:hint="@string/change_password_retype_password"
                    android:imeOptions="actionDone" />


