<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/Layout_Padding"
    android:background="@android:color/transparent">

    <LinearLayout
        style="@style/Layout_Dialog"
        android:layout_centerInParent="true"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_title"
            style="@style/TextView_Header"
            android:layout_gravity="center"
            android:layout_marginTop="@dimen/activity_vertical_margin"
            android:gravity="center" />

        <TextView
            android:id="@+id/tv_message"
            style="@style/TextView_Title"
            android:layout_gravity="center"
            android:layout_marginLeft="@dimen/activity_vertical_margin"
            android:layout_marginTop="@dimen/activity_vertical_margin"
            android:layout_marginRight="@dimen/activity_vertical_margin"
            android:layout_marginBottom="@dimen/activity_vertical_margin"
            android:gravity="center_horizontal" />

        <include layout="@layout/layout_line_horizontal" />

        <LinearLayout
            style="@style/WidthMatch"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btn_negative"
                style="@style/Button_Base"
                android:layout_weight="1"
                android:textColor="@color/colorRed" />

            <include layout="@layout/layout_line_vertical" />

            <TextView
                android:id="@+id/btn_positive"
                style="@style/Button_Base"
                android:layout_weight="1"
                android:textColor="@drawable/btn_ok_color" />

        </LinearLayout>
    </LinearLayout>
</RelativeLayout>