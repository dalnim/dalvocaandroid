<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clickable="true"
    android:background="#787676"
    android:id="@+id/include_relativelayout"
    android:padding="@dimen/padding_view_word_list">
    <ImageView
        android:id="@+id/close"
        android:layout_width="15dp"
        android:layout_height="15dp"
        android:layout_centerVertical="true"
        android:src="@drawable/ic_cancel"/>
    <TextView
        android:id="@+id/startTime"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif"
        android:textColor="@color/colorBlack"
        android:textSize="15sp"
        android:layout_toRightOf="@id/close"
        tools:ignore="UnusedAttribute"
        android:layout_centerVertical="true"
        tools:text="00:00"
        android:layout_alignParentLeft="false"
        android:gravity="center"
        android:layout_marginLeft="20dp"/>

    <TextView
        android:id="@+id/endTime"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentRight="true"
        android:fontFamily="sans-serif"
        android:textColor="@color/colorBlack"
        android:textSize="15sp"
        android:layout_centerVertical="true"
        tools:ignore="UnusedAttribute"
        tools:text="-05:00"
        android:gravity="center"
        android:layout_marginEnd="15dp" />
    <org.florescu.android.rangeseekbar.RangeSeekBar
        android:id="@+id/seeker"
        android:progressBackgroundTint="@color/colorWhite"
        android:progressTint="@color/colorAccent"
        android:layout_width="wrap_content"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        app:showLabels="false"
        app:activeColor="@color/colorWhite"
        app:internalPadding="0dp"
        app:thumbNormal="@drawable/seek_thumb_normal"
        app:valuesAboveThumbs="false"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:layout_toRightOf="@+id/startTime"
        android:layout_toLeftOf="@+id/endTime" />
</RelativeLayout>