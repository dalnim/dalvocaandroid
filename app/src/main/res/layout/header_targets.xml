<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/WidthMatch">

    <LinearLayout
        android:id="@+id/v_background"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_alignParentEnd="true"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tv_delete"
            android:layout_width="85dp"
            android:layout_height="match_parent" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/v_foreground"
        style="@style/WidthMatch"
        android:background="@color/backgroundCellHeaderColor"
        android:orientation="horizontal"
        android:paddingLeft="8dp"
        android:paddingTop="4dp"
        android:paddingRight="8dp"
        android:paddingBottom="4dp">

        <TextView
            android:id="@+id/tv_grade_number"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="center_vertical"
            android:background="@drawable/bg_circle_orange"
            android:gravity="center"
            android:textColor="@color/colorBlack"
            android:textSize="@dimen/grade_text_size" />

        <ImageView
            android:id="@+id/ic_2"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="center_vertical"
            android:layout_marginLeft="8dp"
            android:visibility="gone"
            tools:visibility="visible"/>

        <ImageView
            android:id="@+id/ic_3"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="center_vertical"
            android:layout_marginLeft="8dp"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/ic_4"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="center_vertical"
            android:layout_marginLeft="8dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tv_grade_text"
            style="@style/FillRemainHorizontal"
            android:layout_gravity="center_vertical"
            android:layout_marginStart="16dp"
            android:textColor="@color/textPrimaryColor"
            android:textSize="@dimen/header_text_size"
            tools:text="grade_text"/>

        <include
            android:id="@+id/ic_play_all"
            layout="@layout/ic_double_volumn_up"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="center_vertical" />
    </LinearLayout>
</RelativeLayout>
