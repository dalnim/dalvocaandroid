<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/chat_background"
    android:orientation="vertical"
    >

    <com.dalread.component.Toolbar
        android:id="@id/header"
        style="@style/WidthMatch"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        
        app:leftIcon="@drawable/ic_back"
        app:rightIcon="@drawable/ic_word_list_circle"
        app:rightText="@string/menu"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/backgroundSteelBlue"
        android:padding="2dp"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/ivSpeaker"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:padding="4dp"
            android:layout_gravity="center"
            android:layout_below="@id/tv_header"
            android:visibility="gone"
            android:src="@drawable/ic_bulb"
            tools:visibility="visible"/>

        <TextView
            android:id="@+id/tvHint"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:paddingStart="10dp"
            android:layout_weight="1"
            android:paddingEnd="10dp"
            android:textColor="@color/dayNightLiteWhiteColor"
            android:layout_gravity="center"
            android:gravity="center|left"
            tools:text="Guide"
            />
    </LinearLayout>

    <!-- User's prompt view -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvConversation"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_weight="1"
        app:layout_constraintBottom_toTopOf="@+id/bottom_action_bar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvHint"
        tools:itemCount="3"
        tools:listitem="@layout/item_gpt_user_prompt"/>


    <include
        android:visibility="gone"
        android:id="@+id/llLayoutQuizStatus"
        layout="@layout/layout_quiz_status"
        tools:visibility="visible"/>

    <include
        android:visibility="gone"
        android:id="@+id/llLayoutQuizAnswerButtons"
        layout="@layout/layout_quiz_answer_buttons"
        tools:visibility="visible"/>

    <include
        android:id="@+id/ll_dialog_record_in_chat"
        layout="@layout/dialog_record_in_chat"/>
    <com.dalread.component.AraFlowLayout
        android:id="@+id/araFlowLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/transparent"
        android:paddingStart="5dp"
        android:paddingEnd="5dp"
        android:visibility="gone"
        android:padding="10dp"
        tools:visibility="visible"/>
</LinearLayout>
