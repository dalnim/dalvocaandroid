<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/llRoot"
    style="@style/ItemBase"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:background="@color/backgroundCellHeaderColor"
    android:paddingTop="@dimen/item_padding_top_bottom"
    android:paddingBottom="@dimen/item_padding_top_bottom">

    <LinearLayout
        android:id="@+id/llMain"
        style="@style/WidthMatch"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:orientation="vertical">
        <TextView
            android:id="@+id/tvVocaCountAll"
            style="@style/WidthMatch"
            android:textColor="@color/textPrimaryColor"
            android:textSize="@dimen/title_play_all_count"
            android:paddingStart="10sp"
            tools:text="All count : 100"/>
        <LinearLayout style="@style/WidthMatch">
            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/scRandomPlayInPlayListByTts"
                style="@style/Item_Setting_Switch"
                android:checked="false"
                android:background="@color/backgroundCellHeaderColor"
                android:text="@string/random_play_in_play_list_by_tts" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
