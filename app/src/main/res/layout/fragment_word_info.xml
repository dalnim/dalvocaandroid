<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/ViewBase"
    android:background="@color/backgroundColor">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingTop="16dp"
            android:paddingBottom="16dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:orientation="vertical">



                <ImageView
                    android:id="@+id/iv_bookmark"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_subtitle"
                    android:visibility="invisible"
                    tools:visibility="visible"
                    />

                <TextView
                    android:id="@+id/tv_know_icon"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginTop="5dp"
                    android:layout_marginBottom="5dp"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:textSize="@dimen/grade_text_size"
                    tools:text="1"/>


                <ImageView
                    android:id="@+id/iv_unknown_pronounce"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_unknown_pronounce"
                    android:visibility="invisible"
                    tools:visibility="visible"
                    />
            </LinearLayout>


            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/textPrimaryColor"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_word"
                    style="@style/TextViewItemVoca"
                    tools:text="word"
                    />

                <TextView
                    android:id="@+id/tv_meaning"
                    style="@style/TextViewItemMeaning"
                    android:textIsSelectable="true"
                    android:layout_marginTop="8dp"
                    tools:text="tv_meaning"/>

                <TextView
                    android:id="@+id/tv_count"
                    style="@style/TextViewSubItem"
                    android:layout_marginStart="8dp"
                    android:layout_marginTop="8dp"
                    tools:text="tv_count"/>
            </LinearLayout>

            <ImageView
                android:id="@+id/ic_play"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:padding="@dimen/icon_play_padding"
                android:src="@drawable/ic_volume_up_48dp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/v_hanja_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_hanja_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false" />

            <View style="@style/Divider" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_hanja"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="@dimen/item_text_hanja_size"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="10dp"
            android:text="For Hanja"
            android:textIsSelectable="true"
            android:visibility="gone"
            tools:visibility="visible"/>

        <TextView
            android:id="@+id/tv_record"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/backgroundGrayColor"
            android:gravity="center"
            android:padding="8dp"
            android:text="@string/record_this_phrase"
            android:textColor="@color/colorBlue"
            android:textSize="@dimen/item_text_size" />

        <View style="@style/Divider" />

        <TextView
            android:id="@+id/tv_naver"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/backgroundGrayColor"
            android:gravity="center"
            android:padding="8dp"
            android:text="@string/open_naver"
            android:textColor="@color/colorBlue"
            android:textSize="@dimen/item_text_size" />

        <TextView
            android:id="@+id/tv_comment"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp"
            android:textSize="@dimen/item_text_size"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tv_example"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/color_recording_background"
            android:paddingStart="16dp"
            android:paddingTop="8dp"
            android:paddingEnd="16dp"
            android:paddingBottom="8dp"
            android:text="@string/example"
            android:textColor="@color/colorBlack"
            android:textSize="@dimen/item_text_size"
            android:visibility="gone" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_example"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
