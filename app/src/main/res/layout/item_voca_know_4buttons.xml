<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/v_item"
    style="@style/WidthMatch"
    android:background="@color/backgroundColor"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:paddingTop="4dp"
    android:paddingBottom="4dp">


    <LinearLayout
        android:id="@+id/linearLayout"
        style="@style/WidthMatch"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="10dp"
        android:layout_weight="1"
        android:orientation="vertical"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:id="@+id/llVocaPronounce"
            style="@style/Wrap"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvVoca"
                style="@style/Textview_Voca"
                android:layout_marginEnd="6dp"
                android:textIsSelectable="true"
                android:textSize="@dimen/item_voca_size"
                tools:text="Voca Voca" />

            <TextView
                android:id="@+id/tvShortPronounce"
                style="@style/Textview_Pronounce"
                android:textIsSelectable="true"
                android:textSize="@dimen/item_pronounce_size"
                android:visibility="gone"
                tools:text="pronounce"
                tools:visibility="visible" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvLongPronounce"
            style="@style/Textview_Pronounce"
            android:textIsSelectable="true"
            android:textSize="@dimen/item_pronounce_size"
            android:visibility="gone"
            tools:text="Long pronounce"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/tvMeaningEnglish"
            style="@style/Textview_Meaning"
            android:textIsSelectable="true"
            android:textSize="@dimen/item_meaning_size_small"
            tools:text="(Meaning English)" />

        <TextView
            android:id="@+id/tvMeaning"
            style="@style/Textview_Meaning"
            android:textIsSelectable="true"
            android:textSize="@dimen/item_meaning_size_small"
            tools:text="Meaning" />

        <TextView
            android:id="@+id/tvMeaningEnglishDetailed"
            style="@style/Textview_Meaning"
            android:textIsSelectable="true"
            android:textSize="@dimen/item_meaning_size_small"
            tools:text="(Meaning Detailed English)" />

        <TextView
            android:id="@+id/tvMeaningDetailed"
            style="@style/Textview_Meaning"
            android:textIsSelectable="true"
            android:textSize="@dimen/item_meaning_size_small"
            tools:text="Meaning Detailed" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/ll_index"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_margin="5dp"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/linearLayout">

        <TextView
            android:id="@+id/tv_index"
            style="@style/TextViewSubItem"
            android:layout_gravity="center"
            android:text="1" />

        <Space
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1" />

        <ImageView
            android:id="@+id/ivCopy"
            style="@style/ImageView_Player_Circle_No_Margin"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:gravity="center"
            android:src="@drawable/ic_copy2" />

        <Space
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1" />

        <ImageView
            android:id="@+id/ivTranslate"
            style="@style/ImageView_Player_Circle_No_Margin"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginEnd="20dp"
            android:paddingTop="1dp"
            android:paddingBottom="1dp"
            android:src="@drawable/ic_translate_black" />


<!--        <ImageView-->
<!--            android:id="@+id/ivSpeaker"-->
<!--            style="@style/ImageView_Player_Circle_No_Margin"-->
<!--            android:src="@drawable/ic_volume_up_48dp" />-->

        <Space
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1" />

        <ImageView
            android:id="@+id/ivBookmark"
            style="@style/ImageView_Player_Circle_No_Margin"
            android:src="@drawable/ic_favorite_new_off"
            tools:ignore="ContentDescription" />

        <Space
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1" />

        <LinearLayout
            android:id="@+id/llKnowValue"
            style="@style/Wrap"
            android:layout_marginEnd="10dp"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/ivKnow"
                style="@style/ImageView_VocaKnow_With_Bookmark"
                android:layout_centerInParent="true"
                android:src="@drawable/ic_voca_know_circle_notrated" />

            <ImageView
                android:id="@+id/ivKnowPronounce"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_centerInParent="true"
                android:layout_gravity="center"
                android:layout_toRightOf="@id/ivKnow"
                android:src="@drawable/ic_unknown_pronounce"
                android:visibility="gone"
                tools:visibility="visible" />
        </LinearLayout>

    </LinearLayout>
    <LinearLayout
        android:id="@+id/ll_4_buttons"
        style="@style/WidthMatch"
        android:gravity="center"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="10dp"
        android:orientation="horizontal"
        android:visibility="visible"
        app:layout_constraintEnd_toEndOf="@+id/linearLayout"
        app:layout_constraintStart_toStartOf="@+id/linearLayout"
        app:layout_constraintTop_toBottomOf="@+id/ll_index"
        tools:visibility="visible">

        <TextView
            android:id="@+id/iv_known"
            style="@style/ButtonGrade"
            android:layout_marginEnd="10dp"
            android:layout_weight="1"
            android:background="@drawable/btn_no_border_voca_know_known"
            android:text="!" />

        <TextView
            android:id="@+id/iv_grade_1"
            style="@style/ButtonGrade"
            android:layout_marginLeft="10dp"
            android:layout_marginRight="10dp"
            android:layout_weight="1"
            android:background="@drawable/btn_no_border_voca_know_amki_grade_1"
            android:text="1" />

        <TextView
            android:id="@+id/iv_grade_2"
            style="@style/ButtonGrade"
            android:layout_marginLeft="10dp"
            android:layout_marginRight="10dp"
            android:layout_weight="1"
            android:background="@drawable/btn_no_border_voca_know_amki_grade_2"
            android:text="2" />

        <TextView
            android:id="@+id/iv_unknown"
            style="@style/ButtonGrade"
            android:layout_marginLeft="10dp"
            android:layout_weight="1"
            android:background="@drawable/btn_no_border_voca_know_unknown"
            android:text="X" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
