<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/v_item"
    style="@style/ItemBase"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingTop="@dimen/item_padding_top_bottom"
    android:paddingBottom="@dimen/item_padding_top_bottom">

    <ImageView
        android:id="@+id/ic_avatar"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:src="@mipmap/ic_no_avatar" />

    <LinearLayout
        style="@style/FillRemainHorizontal"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_name"
            style="@style/TextViewItem" />

        <TextView
            android:id="@+id/tv_nation"
            style="@style/TextViewItem"
            android:layout_marginTop="@dimen/word_meaning_margin_top" />
    </LinearLayout>

    <ImageView
        android:id="@+id/ic_play"
        style="@style/Wrap"
        android:padding="@dimen/icon_play_padding"
        android:src="@drawable/ic_volume_up_48dp" />

    <ImageView
        android:id="@+id/ic_check"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:scaleType="center"
        android:src="@drawable/ic_checkbox_1_checked" />
</LinearLayout>
