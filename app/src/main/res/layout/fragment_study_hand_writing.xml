<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:background="@color/backgroundWhiteColor"
    style="@style/ViewBase">

    <RelativeLayout style="@style/WidthMatch">

        <TextView
            android:id="@+id/tvSentence"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerHorizontal="true"
            android:layout_marginStart="8dp"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="16dp"
            android:gravity="center"
            android:textColor="@color/textPrimaryColor"
            android:textSize="22sp"
            android:lines="2"
            tools:text="Sentence"/>

        <ImageView
            android:id="@+id/ivEye"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_below="@id/tvSentence"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="8dp"
            android:src="@drawable/ic_visibility_black_24dp" />

        <ImageView
            android:id="@+id/ivUndo"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_alignTop="@id/ivEye"
            android:layout_marginEnd="80dp"
            android:layout_toStartOf="@id/ivEye"
            android:src="@drawable/ic_undo_black_24dp"
            app:tint="@color/color_stop" />

        <ImageView
            android:id="@+id/ivRefresh"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_alignTop="@id/ivEye"
            android:layout_marginStart="80dp"
            android:layout_toEndOf="@id/ivEye"
            android:src="@drawable/ic_refresh_24dp"
            app:tint="@color/colorBlack" />

        <TextView
            android:id="@+id/tvVoca"
            android:layout_width="@dimen/study_chinese_box_size"
            android:layout_height="@dimen/study_chinese_box_size"
            android:layout_below="@id/ivEye"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:textColor="@color/color_stop"
            tools:background="@drawable/ic_hangul_1313_giyeok"
            app:autoSizeMaxTextSize="200sp"
            app:autoSizeTextType="uniform" />

        <LinearLayout
            android:id="@+id/v_drawing"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/ivEye"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/ivArrowLeft"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:layout_marginEnd="8dp"
                android:src="@drawable/ic_keyboard_arrow_left_black_36_64dp"
                app:tint="@color/colorBlack" />

            <com.rm.freedrawview.FreeDrawView
                android:id="@+id/fdvVoca"
                android:layout_width="@dimen/study_chinese_box_size"
                android:layout_height="@dimen/study_chinese_box_size"
                android:background="@drawable/btn_border_hangul_writing_background" />

            <ImageView
                android:id="@+id/ivArrowRight"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:layout_marginStart="8dp"
                android:src="@drawable/ic_keyboard_arrow_right_black_36_64dp"
                app:tint="@color/colorBlack" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvMeaning"
            style="@style/WidthMatch"
            android:layout_below="@id/v_drawing"
            android:layout_centerHorizontal="true"
            android:layout_marginStart="8dp"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="16dp"
            android:gravity="center"
            android:textColor="@color/textPrimaryColor"
            android:textSize="22sp"
            tools:text="Meaning"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/v_drawing"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvHanja"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="@color/textPrimaryColor"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/tvPractice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="32dp"
                android:layout_marginTop="16dp"
                android:layout_marginEnd="32dp"
                android:layout_marginBottom="16dp"
                android:gravity="center_horizontal"
                android:textColor="@color/textPrimaryColor"
                android:textSize="@dimen/item_text_size" />
        </LinearLayout>
    </RelativeLayout>
</ScrollView>
