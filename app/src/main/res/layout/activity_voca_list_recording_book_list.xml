<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/llRoot"
    style="@style/ItemBase"
    android:background="@color/backgroundCellHeaderColor"
    android:orientation="vertical">

    <com.dalread.component.Toolbar
        android:id="@id/header"
        style="@style/WidthMatch"
        app:title="@string/recording_list"
        app:leftIcon="@drawable/ic_back" />

    <RelativeLayout
        android:id="@+id/llMain"
        style="@style/WidthMatch"
        android:padding="10dp"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/tvRecordedCount"
            style="@style/Wrap"
            android:layout_alignParentStart="true"
            android:layout_centerInParent="true"
            android:textColor="@color/textPrimaryColor"
            android:padding="8dp"
            android:layout_marginStart="10dp"
            android:textSize="@dimen/header_text_size"
            tools:text="All count : 100"/>

        <ImageView
            android:id="@+id/ivShowRecordedCount"
            style="@style/Wrap"
            android:layout_alignParentEnd="true"
            android:layout_centerInParent="true"
            android:layout_marginEnd="10dp"
            android:src="@drawable/ic_refresh"/>

    </RelativeLayout>



    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_book"
        style="@style/Match"
        tools:itemCount="3"
        tools:listitem="@layout/item_voca_books_common"/>
</LinearLayout>
