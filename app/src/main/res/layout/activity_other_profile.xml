<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/ViewBase"
    android:orientation="vertical">

    <com.dalread.component.Toolbar
        android:id="@id/header"
        style="@style/WidthMatch"
        app:title="@string/profile"
        app:leftIcon="@drawable/ic_back" />

    <ScrollView style="@style/Match">

        <LinearLayout
            style="@style/WidthMatch"
            android:orientation="vertical">

            <LinearLayout
                style="@style/WidthMatch"
                android:background="@color/backgroundColor"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_online"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_gravity="center_horizontal"
                    android:drawableStart="@drawable/circle_black"
                    android:drawablePadding="4dp"
                    android:gravity="center"
                    android:textSize="@dimen/sub_item_text_size" />

                <RelativeLayout style="@style/WidthMatch">

                    <ImageView
                        android:id="@+id/ic_following"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_toStartOf="@id/iv_avatar" />

                    <ImageView
                        android:id="@+id/ic_allow_chat"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_toEndOf="@id/iv_avatar" />

                    <ImageView
                        android:id="@+id/iv_avatar"
                        android:layout_width="90dp"
                        android:layout_height="90dp"
                        android:layout_centerInParent="true"
                        android:layout_marginStart="32dp"
                        android:layout_marginEnd="32dp" />

                    <ImageView
                        android:id="@+id/ic_block"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_below="@id/iv_avatar"
                        android:layout_toStartOf="@id/iv_avatar" />

                    <ImageView
                        android:id="@+id/ic_favorite"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_below="@id/iv_avatar"
                        android:layout_toEndOf="@id/iv_avatar" />
                </RelativeLayout>

                <ImageView
                    android:id="@+id/iv_introduction"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_gravity="center_horizontal"
                    android:src="@drawable/ic_volume_up_48dp"
                    android:tint="@color/color_black_speaker_icon"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tv_name"
                    style="@style/Wrap"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="16dp"
                    android:textSize="32sp"
                    android:textStyle="bold" />

                <LinearLayout
                    style="@style/WidthMatch"
                    android:layout_marginTop="4dp"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <ImageView
                        style="@style/Wrap"
                        android:src="@drawable/ic_location_on_black_24dp"
                        android:tint="@color/color_location_icon" />

                    <TextView
                        android:id="@+id/tv_location"
                        style="@style/Wrap"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginStart="16dp"
                        android:textSize="20sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tv_join_date"
                    style="@style/Wrap"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="12dp"
                    android:textSize="12sp" />

                <LinearLayout
                    style="@style/WidthMatch"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center_horizontal"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tv_score"
                            style="@style/Wrap"
                            android:textSize="16sp" />

                        <TextView
                            style="@style/Wrap"
                            android:text="@string/score"
                            android:textSize="16sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center_horizontal"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tv_following_count"
                            style="@style/Wrap"
                            android:textSize="16sp" />

                        <TextView
                            style="@style/Wrap"
                            android:text="@string/following"
                            android:textSize="16sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center_horizontal"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tv_follower_count"
                            style="@style/Wrap"
                            android:textSize="16sp" />

                        <TextView
                            style="@style/Wrap"
                            android:text="@string/follower"
                            android:textSize="16sp" />
                    </LinearLayout>
                </LinearLayout>

                <FrameLayout
                    style="@style/WidthMatch"
                    android:descendantFocusability="beforeDescendants"
                    android:focusableInTouchMode="true">

                    <EditText
                        android:id="@+id/et_nickname"
                        style="@style/EditText_Main"
                        android:layout_margin="16dp"
                        android:background="@drawable/background_edittext"
                        android:hint="@string/hint_add_nickname"
                        android:imeOptions="actionDone" />
                </FrameLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/v_desc_by_me"
                style="@style/ItemSetting">

                <TextView
                    android:id="@+id/tv_desc_by_me"
                    style="@style/TextViewSettingLabel"
                    android:ellipsize="end"
                    android:maxLines="2"
                    tools:text="desc by me"/>

                <ImageView
                    style="@style/Wrap"
                    android:layout_gravity="center_vertical"
                    android:src="@drawable/ic_keyboard_arrow_right_36dp" />
            </LinearLayout>

            <View style="@style/Divider" />

            <LinearLayout
                android:id="@+id/v_hide_info"
                style="@style/WidthMatch"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/v_bio"
                    style="@style/ItemSetting">

                    <TextView
                        android:id="@+id/tv_bio"
                        style="@style/TextViewSettingLabel"
                        android:ellipsize="end"
                        android:maxLines="2"
                        tools:text="bio"/>

                    <ImageView
                        style="@style/Wrap"
                        android:layout_gravity="center_vertical"
                        android:src="@drawable/ic_keyboard_arrow_right_36dp" />
                </LinearLayout>

                <View style="@style/Divider" />

                <LinearLayout
                    android:id="@+id/v_1st_grade"
                    style="@style/ItemSetting">

                    <TextView
                        style="@style/TextViewSettingLabel"
                        android:text="@string/first_grade_phrases" />

                    <ImageView
                        style="@style/Wrap"
                        android:layout_gravity="center_vertical"
                        android:src="@drawable/ic_keyboard_arrow_right_36dp" />
                </LinearLayout>

                <View style="@style/Divider" />

                <LinearLayout
                    android:id="@+id/v_following"
                    style="@style/ItemSetting">

                    <TextView
                        style="@style/TextViewSettingLabel"
                        android:text="@string/following" />

                    <ImageView
                        style="@style/Wrap"
                        android:layout_gravity="center_vertical"
                        android:src="@drawable/ic_keyboard_arrow_right_36dp" />
                </LinearLayout>

                <View style="@style/Divider" />

                <LinearLayout
                    android:id="@+id/v_follower"
                    style="@style/ItemSetting">

                    <TextView
                        style="@style/TextViewSettingLabel"
                        android:text="@string/follower" />

                    <ImageView
                        style="@style/Wrap"
                        android:layout_gravity="center_vertical"
                        android:src="@drawable/ic_keyboard_arrow_right_36dp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/v_student_lesson_option_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <View style="@style/Divider" />

                    <LinearLayout
                        android:id="@+id/v_student_lesson_option"
                        style="@style/ItemSetting">

                        <TextView
                            style="@style/TextViewSettingLabel"
                            android:text="@string/student_lesson_option" />

                        <ImageView
                            style="@style/Wrap"
                            android:layout_gravity="center_vertical"
                            android:src="@drawable/ic_keyboard_arrow_right_36dp" />
                    </LinearLayout>
                </LinearLayout>

                <View style="@style/Divider" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
