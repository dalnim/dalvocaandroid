<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    android:background="@color/colorBackground"
    tools:context=".activity.ReadingListActivity">

    <include layout="@layout/layout_header" />

    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_weight="1">

        <com.google.android.material.appbar.AppBarLayout
            android:id="@+id/appBar"
            android:layout_width="match_parent"
            android:layout_height="@dimen/header_size"
            android:fitsSystemWindows="true"
            app:expanded="false">

            <com.google.android.material.appbar.CollapsingToolbarLayout
                android:id="@+id/collapsingToolbar"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/color_word_list_edit_text"
                android:fitsSystemWindows="true"
                app:contentScrim="@color/colorBackground"
                app:expandedTitleMarginBottom="32dp"
                app:expandedTitleMarginEnd="64dp"
                app:expandedTitleMarginStart="48dp"
                app:layout_scrollFlags="scroll|exitUntilCollapsed">

                <LinearLayout
                    style="@style/WidthMatch"
                    android:orientation="horizontal">

                    <com.dalread.component.ClearableEditText
                        android:id="@+id/etSearch"
                        style="@style/EditText_Main"
                        android:layout_margin="@dimen/edit_text_margin"
                        android:layout_weight="1"
                        android:background="@drawable/background_edittext"
                        android:drawablePadding="@dimen/edit_text_margin"
                        android:hint="@string/reading_list_search"
                        android:imeOptions="actionDone" />

                    <TextView
                        android:id="@+id/tvCancel"
                        style="@style/TextView_Title"
                        android:layout_gravity="center"
                        android:text="@string/login_btn_cancel"
                        android:layout_marginRight="@dimen/edit_text_margin"
                        android:textColor="@color/colorBlue"
                        android:visibility="gone" />
                </LinearLayout>

            </com.google.android.material.appbar.CollapsingToolbarLayout>
        </com.google.android.material.appbar.AppBarLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/listView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_behavior="@string/appbar_scrolling_view_behavior"/>
    </androidx.coordinatorlayout.widget.CoordinatorLayout>

</LinearLayout>
