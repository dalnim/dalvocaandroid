<?xml version="1.0" encoding="UTF-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    style="@style/ViewBase"
    android:background="@color/backgroundColor"
    android:orientation="vertical">

    <ScrollView
        android:id="@+id/sv_main"
        style="@style/Match">
        <LinearLayout
            style="@style/Match"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvDictationText"
                style="@style/WidthMatch"
                android:layout_marginStart="32dp"
                android:layout_marginEnd="32dp"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="16dp"
                android:background="@drawable/btn_grey_border_white_background"
                android:minHeight="100dp"
                android:textSize="@dimen/item_text_size" />
            <LinearLayout
                style="@style/WidthMatch"
                android:layout_marginStart="22dp"
                android:layout_marginEnd="22dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvDictationMeaning"
                    style="@style/TextView_Title"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:maxLines="3" />

            </LinearLayout>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvDictationList"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:clipToPadding="false"
                android:padding="@dimen/study_english_small_box_offset"
                tools:itemCount="3"
                tools:listitem="@layout/item_study_writing_english"/>

            <com.dalread.component.CustomHorizontalScrollView
                android:id="@+id/llDictationMeaningDisplayScroll"
                style="@style/WidthMatch"
                android:layout_centerInParent="true"
                android:layout_marginLeft="20dp"
                android:layout_marginTop="10dp"
                android:layout_marginRight="20dp"
                android:layout_marginBottom="10dp"
                android:fillViewport="true"
                android:padding="10dp"
                android:background="@color/backgroundEditTextColor"
                android:scrollbars="none">

                <TextView
                    android:id="@+id/tvDictationMeaningDisplay"
                    style="@style/TextView_Title"
                    android:layout_width="match_parent"
                    android:background="@color/backgroundEditTextColor"
                    android:lines="1" />
            </com.dalread.component.CustomHorizontalScrollView>
        </LinearLayout>
    </ScrollView>
</LinearLayout>