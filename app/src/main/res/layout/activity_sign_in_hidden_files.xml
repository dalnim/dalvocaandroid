<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Layout_Padding"
    android:background="@android:color/transparent">

    <LinearLayout
        style="@style/Layout_Dialog"
        android:layout_gravity="center"
        android:orientation="vertical">

        <include layout="@layout/layout_line_horizontal" />

        <ScrollView
            style="@style/Match"
            android:paddingVertical="2dp">

            <LinearLayout
                style="@style/WidthMatch"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvSignInUpMessage"
                    style="@style/Wrap"
                    android:layout_gravity="center"
                    android:layout_margin="10dp"
                    android:layout_marginStart="20dp"
                    android:layout_marginEnd="20dp"
                    android:text="@string/sign_up_message_hidden_files"
                    android:textColor="@color/textSignInUpMessageColor" />

                <EditText
                    android:id="@+id/etPassword"
                    style="@style/EditText_PassWord"
                    android:layout_marginLeft="@dimen/activity_vertical_margin"
                    android:layout_marginTop="5dp"
                    android:layout_marginRight="@dimen/activity_vertical_margin"
                    android:layout_marginBottom="5dp"
                    android:inputType="numberPassword"
                    android:background="@drawable/background_edittext_center_round"
                    android:hint="@string/login_password"
                    android:imeOptions="actionNext"
                    />

                <LinearLayout
                    android:id="@+id/llLogInBody"
                    style="@style/WidthMatch"
                    android:layout_centerInParent="true"
                    android:orientation="vertical">


                    <TextView
                        android:id="@+id/tvChangePassword"
                        style="@style/Wrap"
                        android:layout_gravity="right"
                        android:layout_marginTop="10dp"
                        android:layout_marginEnd="10dp"
                        android:layout_marginBottom="15dp"
                        android:text="@string/login_change_password"
                        android:textSize="16sp"
                        android:textColor="@color/textSignInUpMessageColor"

                        />


                    <LinearLayout
                        style="@style/Match"
                        android:layout_centerInParent="true"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/btnLogIn"
                            style="@style/Button_Base"
                            android:layout_margin="10dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_border_4dp_primary_color"
                            android:text="@string/login_btn_ok"
                            android:textColor="@color/textVeryLiteWhiteColor" />

                        <TextView
                            android:id="@+id/btnCancel"
                            style="@style/Button_Base"
                            android:layout_margin="10dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_border_4dp_gray"
                            android:text="@string/login_btn_cancel"
                            android:textColor="@color/textVeryLiteWhiteColor" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/llSignUpBody"
                    style="@style/WidthMatch"
                    android:layout_centerInParent="true"
                    android:orientation="vertical"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <EditText
                        android:id="@+id/etRetypePassword"
                        style="@style/EditText_PassWord"
                        android:layout_marginLeft="@dimen/activity_vertical_margin"
                        android:layout_marginTop="5dp"
                        android:layout_marginRight="@dimen/activity_vertical_margin"
                        android:layout_marginBottom="5dp"
                        android:inputType="numberPassword"
                        android:background="@drawable/background_edittext_center_round"
                        android:hint="@string/sign_up_retype_password"
                        android:imeOptions="actionNext" />


                    <TextView
                        android:id="@+id/btnSignUp"
                        style="@style/Button_Base"
                        android:layout_margin="10dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_border_4dp_primary_color"
                        android:text="@string/ok"
                        android:textColor="@color/textVeryLiteWhiteColor" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
    </LinearLayout>
</FrameLayout>