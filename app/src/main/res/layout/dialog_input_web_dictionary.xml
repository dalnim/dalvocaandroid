<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/Layout_Padding"
    android:background="@android:color/transparent">

    <LinearLayout
        style="@style/Layout_Dialog"
        android:layout_centerInParent="true"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_title"
            style="@style/TextView_Header"
            android:layout_gravity="center"
            android:layout_marginTop="@dimen/activity_vertical_margin"
            android:gravity="center"
            android:text="@string/web_dictionary"/>

        <TextView
            android:id="@+id/tv_sub_title"
            style="@style/TextView_Title"
            android:layout_gravity="center"
            android:layout_marginLeft="@dimen/activity_vertical_margin"
            android:layout_marginTop="8dp"
            android:layout_marginRight="@dimen/activity_vertical_margin"
            android:gravity="center"
            android:text="@string/web_dictionary_description"/>

        <EditText
            android:id="@+id/et_title"
            style="@style/EditText_Main"
            android:layout_marginStart="16dp"
            android:layout_marginTop="@dimen/activity_vertical_margin"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="@dimen/activity_vertical_margin"
            android:background="@drawable/background_edittext"
            android:hint="@string/title"
            android:textColor="@color/color_text"
            android:textColorHint="@color/color_text"
            android:imeOptions="actionNext"
            android:inputType="text" />

        <EditText
            android:id="@+id/et_url"
            style="@style/EditText_Main"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="@dimen/activity_vertical_margin"
            android:background="@drawable/background_edittext"
            android:hint="@string/type_a_url"
            android:imeOptions="actionDone"
            android:textColor="@color/color_text"
            android:textColorHint="@color/color_text"
            android:inputType="text" />


        <include layout="@layout/layout_line_horizontal" />

        <LinearLayout
            style="@style/WidthMatch"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btn_cancel"
                style="@style/Button_Base"
                android:layout_weight="1"
                android:text="@string/cancel"
                android:textColor="@color/colorRed" />

            <include layout="@layout/layout_line_vertical" />

            <TextView
                android:id="@+id/btn_save"
                style="@style/Button_Base"
                android:layout_weight="1"
                android:text="@string/save"
                android:textColor="@drawable/btn_ok_color" />
        </LinearLayout>
    </LinearLayout>
</RelativeLayout>