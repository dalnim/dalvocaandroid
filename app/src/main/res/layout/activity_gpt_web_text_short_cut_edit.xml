<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/bg_border_16dp_white"
    android:layout_marginStart="8dp"
    android:layout_marginEnd="8sp"
    android:orientation="vertical">

    <ScrollView style="@style/Match">
        <LinearLayout
            style="@style/WidthMatch"
            android:orientation="vertical"
            android:paddingTop="8dp">

            <EditText
                android:id="@+id/etShortcut"
                style="@style/TextView_prompt_Edit"
                android:hint="@string/type_common_phrases" />
            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/tbForPopupMenu1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:text="@string/swtich_prompt_for_popup_menu_1"
                android:checked="false" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <TextView
                    android:id="@+id/btnCancel"
                    style="@style/Button_Bottom_Base"
                    android:background="@drawable/bg_btn_cancel_bottom_left_radius"
                    android:text="@string/login_btn_cancel" />
                <TextView
                    android:id="@+id/btnOk"
                    style="@style/Button_Bottom_Base"
                    android:background="@drawable/bg_btn_ok_bottom_right_radius"
                    android:text="@string/tts_ok"/>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
