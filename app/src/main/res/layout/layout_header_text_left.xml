<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/vLayoutHeader"
    style="@style/Layout_Header"
    android:orientation="horizontal">

    <ImageView
        android:id="@+id/ivHeaderLeft"
        android:layout_marginLeft="16dp"
        style="@style/ImageView_Header"
        android:layout_alignParentLeft="true"
        android:layout_centerVertical="true"
        android:src="@drawable/ic_drawer_menu" />

    <TextView
        android:id="@+id/tvHeaderTitle"
        style="@style/TextView_Header_White"
        android:layout_centerInParent="true"
        android:layout_gravity="center"
        android:gravity="center" />

    <TextView
        android:gravity="center"
        android:id="@+id/tvHeaderRight"
        style="@style/Wrap"
        android:layout_alignParentRight="true"
        android:layout_gravity="center"
        android:textColor="@color/colorWhite"
        android:textSize="@dimen/font_header" />

</RelativeLayout>