    <TextView
        android:id="@+id/tvLangLevel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="100dp"
        android:text="@string/menu_langauge_level"
        android:textSize="26sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <Button
        android:id="@+id/btnWordLevelBeginner"
        style="@style/LanguageLevelButtonStyle"
        android:layout_marginTop="50dp"
        android:text="@string/sign_up_word_level_beginner"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvLangLevel" />

    <Button
        android:id="@+id/btnWordLevelPreIntermediate"
