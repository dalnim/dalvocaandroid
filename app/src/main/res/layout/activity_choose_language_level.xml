        app:layout_constraintTop_toBottomOf="@+id/btnWordLevelBeginner" />

    <Button
        android:id="@+id/btnWordLevelIntermediate"
        style="@style/LanguageLevelButtonStyle"
        android:text="@string/sign_up_word_level_intermediate"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/btnWordLevelPreIntermediate" />

    <Button
        android:id="@+id/btnWordLevelPostIntermediate"
        style="@style/LanguageLevelButtonStyle"
        android:text="@string/sign_up_word_level_post_intermediate"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/btnWordLevelIntermediate" />

    <Button
        android:id="@+id/btnWordLevelAdvanced"
        style="@style/LanguageLevelButtonStyle"
        android:text="@string/sign_up_word_level_advanced"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/btnWordLevelPostIntermediate" />

