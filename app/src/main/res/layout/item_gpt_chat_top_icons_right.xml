<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/v_item"
    style="@style/WidthMatch"
    android:gravity="center|end"
    android:background="@color/chat_background"
    android:orientation="horizontal"
    android:paddingStart="10dp"
    android:paddingEnd="10dp"
    android:paddingTop="4dp"
    android:paddingBottom="4dp">
        <ImageButton
            android:id="@+id/ibSpeaker"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginEnd="10dp"
            android:background="@color/transparent"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_volume_up_outline_48dp"
            app:tint="@color/icon_day_only_color3"/>

        <ImageButton
            android:id="@+id/ibCopy"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginEnd="10dp"
            android:background="@color/transparent"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_copy2"
            app:tint="@color/icon_day_only_color3"/>


        <ImageView
            android:id="@+id/ivTranslate"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginEnd="10dp"
            android:background="@color/transparent"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_translate_black"
            app:tint="@color/icon_day_only_color3"
            />

        <ImageButton
            android:id="@+id/ibVocaList"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginEnd="10dp"
            android:background="@color/transparent"
            android:src="@drawable/ic_word_list"
            app:tint="@color/icon_day_only_color3" />

        <ImageButton
            android:id="@+id/ivGptIcon"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginEnd="10dp"
            android:background="@color/transparent"
            android:src="@drawable/ic_chatgpt"
            android:scaleType="fitCenter"
            app:tint="@color/icon_day_only_color3" />

        <ImageView
            android:id="@+id/ivBookmark"
            style="@style/ImageView_Player_Circle_No_Margin"
            android:src="@drawable/ic_favorite_new_on"
            tools:ignore="ContentDescription" />

        <LinearLayout
            android:id="@+id/llKnowValue"
            style="@style/Wrap"
            android:layout_marginEnd="10dp"
            android:layout_gravity="center"
            android:orientation="horizontal">

                <ImageView
                    android:id="@+id/ivKnow"
                    style="@style/ImageView_VocaKnow_With_Bookmark"
                    android:layout_centerInParent="true"
                    android:padding="5dp"
                    android:src="@drawable/ic_voca_know_text_not_rated" />

                <ImageView
                    android:id="@+id/ivKnowPronounce"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_centerInParent="true"
                    android:layout_gravity="center"
                    android:layout_toRightOf="@id/ivKnow"
                    android:src="@drawable/ic_unknown_pronounce"
                    android:visibility="gone"
                    tools:visibility="visible" />
        </LinearLayout>

        <ImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_avatar_female_2"/>
</LinearLayout>
