<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/vLayoutHeader"
    style="@style/Layout_Header"
    android:background="@color/backgroundToolbarColor"
    android:orientation="horizontal">

    <ImageView
        android:id="@+id/ivHeaderLeft"
        style="@style/ImageView_Header"
        android:padding="@dimen/padding_icon_header"
        android:layout_gravity="center"
        android:src="@drawable/ic_drawer_menu" />

    <TextView
        android:id="@+id/tvHeaderTitle"
        style="@style/TextView_Header_White"
        android:layout_gravity="center"
        android:layout_weight="1"
        android:gravity="center"
        tools:text="Sign up"/>

    <ImageView
        android:id="@+id/ivHeaderRight"
        style="@style/ImageView_Header"
        android:padding="@dimen/padding_icon_header"
        android:layout_gravity="center"
        android:src="@drawable/ic_book" />

</LinearLayout>