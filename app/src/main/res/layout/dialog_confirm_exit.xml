<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Layout_Padding"
    android:padding="0dp"
    android:background="@android:color/transparent">

    <LinearLayout
        style="@style/Layout_Dialog"
        android:layout_centerInParent="true"
        android:background="@drawable/bg_border_4dp_gray_inside_white"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_title"
            style="@style/TextView_Header"
            android:layout_gravity="center"
            android:paddingTop="16dp"
            android:gravity="center"
            android:text="@string/msg_confirm_title" />

        <TextView
            android:id="@+id/tv_message"
            style="@style/TextView_Body"
            android:layout_gravity="center"
            android:padding="16dp"
            android:text="@string/msg_confirm_exit_app"
            android:gravity="center_horizontal"/>

        <include layout="@layout/layout_line_horizontal" />

        <LinearLayout
            style="@style/WidthMatch"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/btnCancel"
                style="@style/Multi_Button_Base"
                android:layout_weight="1"
                android:text="@string/msg_confirm_no"
                android:textColor="@color/colorRed" />
            <include layout="@layout/layout_line_vertical" />
            <TextView
                android:id="@+id/btnYes"
                style="@style/Multi_Button_Base"
                android:layout_weight="1"
                android:text="@string/msg_confirm_yes"
                android:textColor="@drawable/btn_ok_color" />


        </LinearLayout>
    </LinearLayout>
</RelativeLayout>