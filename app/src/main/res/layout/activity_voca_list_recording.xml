<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/ViewBase"
    android:orientation="vertical">

    <com.dalread.component.Toolbar
        android:id="@id/header"
        style="@style/WidthMatch"
        app:leftIcon="@drawable/ic_back"
        app:title="@string/recording_list" />

    <LinearLayout
        android:id="@+id/v_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/color_header_background"
        android:orientation="vertical">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
        <ImageView
            android:id="@+id/ivHelp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_help"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"
            android:layout_gravity="center"
            />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_book_name"
                style="@style/TextViewItem"
                tools:text="Book name"/>

            <TextView
                android:id="@+id/tv_record_count"
                style="@style/TextViewItem"
                android:layout_marginTop="8dp"
                tools:text="Recorded : 4/10"/>
        </LinearLayout>
        <ImageView
            android:id="@+id/ivDownloadFile"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_download"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"
            android:layout_gravity="center"
            />

        <include
            android:id="@+id/ic_play_all"
            layout="@layout/ic_double_volumn_up"
            android:visibility="gone"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:layout_marginTop="24dp"
            android:layout_marginEnd="8dp"
            android:layout_marginBottom="24dp"
            tools:visibility="visible"/>

        </LinearLayout>
        <LinearLayout style="@style/WidthMatch">
            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/scUploadRecordingAutomatically"
                style="@style/Item_Setting_Switch"
                android:checked="false"
                android:layout_marginBottom="5dp"
                android:background="@color/color_header_background"
                android:text="@string/upload_recording_automatically" />
        </LinearLayout>
    </LinearLayout>



    <FrameLayout
        style="@style/Match"
        android:orientation="vertical"
        android:background="@drawable/background_table_view">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvVoca"
            style="@style/Match"
            android:background="@color/backgroundCellColor"
            tools:itemCount="2"
            tools:listitem="@layout/item_voca_list_recording"/>
        <TextView
            android:id="@+id/tvNoItemToRecordVoice"
            style="@style/HeightMatch"
            android:layout_gravity="center"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"
            android:gravity="center"
            android:text="@string/message_recorded_voice_for_all_items"
            android:textColor="@color/textPrimaryColor"
            android:textSize="@dimen/font_title"
            android:visibility="gone"
            tools:visibility="visible"/>
    </FrameLayout>
</LinearLayout>
