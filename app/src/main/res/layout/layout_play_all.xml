<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:tools="http://schemas.android.com/tools"
    android:background="@color/backgroundGrayColor"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingEnd="16dp">

    <TextView
        android:id="@+id/tvSelectRange"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:layout_marginStart="8dp"
        android:layout_weight="1"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:text="@string/title_select_range"
        android:textColor="@color/colorBlue"
        android:textSize="14sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="play all" />

    <TextView
        android:id="@+id/tvCheckItem"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:layout_marginStart="16dp"
        android:layout_weight="1"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:text="@string/title_check_item"
        android:textColor="@color/colorBlue"
        android:textSize="14sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/tvSelectRange"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="play all" />

    <ImageView
        android:id="@+id/ic_play"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:src="@drawable/ic_play_black_24dp"
        app:layout_constraintEnd_toStartOf="@+id/ic_pause"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/ic_pause"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:src="@drawable/ic_pause_black_24dp"
        app:layout_constraintEnd_toStartOf="@+id/ic_stop"
        app:layout_constraintTop_toTopOf="@+id/ic_play" />

    <ImageView
        android:id="@+id/ic_stop"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginEnd="8dp"
        android:src="@drawable/ic_stop_black_24dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/ic_play" />
</androidx.constraintlayout.widget.ConstraintLayout>
