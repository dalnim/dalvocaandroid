<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/Match"
    android:background="@android:color/transparent">

    <LinearLayout
        style="@style/Layout_Dialog"
        android:layout_height="match_parent"
        android:layout_centerInParent="true"
        android:orientation="vertical">

        <WebView
            android:id="@+id/webView"
            style="@style/Match"
            android:foreground="@color/dayTransparentNightHalfTransparentBlackColor"
            android:layout_weight="1" />

        <View
            style="@style/Divider"
            android:layout_marginStart="0dp"
            android:background="@color/colorBorderBackgroundDialog" />

        <LinearLayout
            style="@style/Layout_Dialog"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/tv_close1"
                style="@style/Button_Base"
                android:padding="@dimen/activity_vertical_margin"
                android:text=""
                android:layout_weight="1"
                android:visibility="gone"
                android:textColor="@drawable/btn_ok_color" />
            <TextView
                android:id="@+id/tv_close"
                style="@style/Button_Base"
                android:padding="@dimen/activity_vertical_margin"
                android:text="@string/close"
                android:layout_weight="1"
                android:visibility="gone"
                android:textColor="@drawable/btn_ok_color" />
            <TextView
                android:id="@+id/tv_back"
                style="@style/Button_Base"
                android:padding="@dimen/activity_vertical_margin"
                android:text="@string/webview_back"
                android:layout_weight="1"
                android:textColor="@drawable/btn_ok_color" />

            <include layout="@layout/layout_line_vertical" />

            <TextView
                android:id="@+id/tvMakeTrasnparency"
                style="@style/Button_Base"
                android:padding="@dimen/activity_vertical_margin"
                android:text="@string/make_half_transparent"
                android:layout_weight="1"
                android:textColor="@drawable/btn_ok_color" />
        </LinearLayout>
    </LinearLayout>

    <ProgressBar
        android:id="@+id/pb_loading"
        style="@style/Wrap"
        android:layout_centerInParent="true" />
</RelativeLayout>