<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/Layout_Padding"
    android:background="@android:color/transparent">

    <LinearLayout
        style="@style/Layout_Dialog"
        android:layout_centerInParent="true"
        android:orientation="vertical">

        <TextView
            style="@style/Wrap"
            android:layout_gravity="center"
            android:layout_margin="@dimen/activity_vertical_margin"
            android:gravity="center"
            android:text="@string/set_to_all_phrases"
            android:textColor="@color/color_text"
            android:textSize="12sp" />

        <View
            style="@style/Divider"
            android:layout_marginStart="0dp"
            android:background="@color/colorBorderBackgroundDialog" />

        <RelativeLayout
            android:id="@+id/v_known"
            style="@style/WidthMatch">

            <TextView
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_centerVertical="true"
                android:layout_margin="8dp"
                android:background="@drawable/bg_circle_light_blue"
                android:gravity="center"
                android:text="!"
                android:textSize="16sp" />

            <TextView
                style="@style/Wrap"
                android:layout_centerInParent="true"
                android:text="@string/known_phrases"
                android:textColor="@color/colorButtonOkEnable"
                android:textSize="16sp" />
        </RelativeLayout>

        <View
            style="@style/Divider"
            android:layout_marginStart="0dp" />

        <RelativeLayout
            android:id="@+id/v_exclude"
            style="@style/WidthMatch">

            <TextView
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_centerVertical="true"
                android:layout_margin="8dp"
                android:background="@drawable/bg_circle_grey"
                android:gravity="center"
                android:text="X"
                android:textSize="16sp" />

            <TextView
                style="@style/Wrap"
                android:layout_centerInParent="true"
                android:text="@string/unknown_phrases"
                android:textColor="@color/colorButtonOkEnable"
                android:textSize="16sp" />
        </RelativeLayout>

        <View
            style="@style/Divider"
            android:layout_marginStart="0dp" />

        <RelativeLayout
            android:id="@+id/v_blink"
            style="@style/WidthMatch">

            <TextView
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_centerVertical="true"
                android:layout_margin="8dp"
                android:background="@drawable/bg_circle_grey"
                android:gravity="center"
                android:text="X"
                android:textSize="16sp"
                android:visibility="invisible" />

            <TextView
                android:id="@+id/tv_blink"
                style="@style/Wrap"
                android:layout_centerInParent="true"
                android:text="@string/blink_mode"
                android:textColor="@color/colorButtonOkEnable"
                android:textSize="16sp" />
        </RelativeLayout>

        <View
            style="@style/Divider"
            android:layout_marginStart="0dp" />

        <RelativeLayout
            android:id="@+id/v_asterisk"
            style="@style/WidthMatch">

            <TextView
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_centerVertical="true"
                android:layout_margin="8dp"
                android:background="@drawable/bg_circle_grey"
                android:gravity="center"
                android:text="X"
                android:textSize="16sp"
                android:visibility="invisible" />

            <TextView
                android:id="@+id/tv_asterisk"
                style="@style/Wrap"
                android:layout_centerInParent="true"
                android:text="@string/display_sentence_as_star"
                android:textColor="@color/colorButtonOkEnable"
                android:textSize="16sp" />
        </RelativeLayout>

        <RelativeLayout
            android:id="@+id/v_backToHome"
            style="@style/WidthMatch">

            <TextView
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_centerVertical="true"
                android:layout_margin="8dp"
                android:background="@drawable/bg_circle_grey"
                android:gravity="center"
                android:text="X"
                android:textSize="16sp"
                android:visibility="invisible" />

            <TextView
                android:id="@+id/tv_backToHome"
                style="@style/Wrap"
                android:layout_centerInParent="true"
                android:text="@string/back_to_home"
                android:textColor="@color/colorButtonOkEnable"
                android:textSize="16sp" />
        </RelativeLayout>

        <View
            style="@style/Divider"
            android:layout_marginStart="0dp" />

        <TextView
            android:id="@+id/tv_action"
            style="@style/Button_Base"
            android:layout_width="wrap_content"
            android:layout_gravity="center"
            android:text="@string/cancel"
            android:textColor="@drawable/btn_ok_color" />
    </LinearLayout>
</RelativeLayout>
