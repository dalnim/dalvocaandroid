<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawer_layout"
    style="@style/Match"
    tools:openDrawer="start">

    <LinearLayout
        style="@style/ViewBase"
        android:orientation="vertical">

        <com.dalread.component.Toolbar
            android:id="@id/header"
            style="@style/WidthMatch"
            app:title="@string/app_name"
            app:leftIcon="@drawable/ic_drawer_menu"
            app:rightText="@string/help_" />

        <ScrollView style="@style/Match">

            <LinearLayout
                style="@style/WidthMatch"
                android:orientation="vertical">

<!--                <include layout="@layout/layout_today_expression" />-->

                <LinearLayout
                    android:id="@+id/v_today"
                    style="@style/WidthMatch"
                    android:background="#FCF1E3"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp">

                    <TextView
                        style="@style/TextViewItem"
                        android:layout_marginTop="16dp"
                        android:gravity="center_horizontal"
                        android:text="@string/today_expression" />

                    <TextView
                        android:id="@+id/tv_today_voca"
                        style="@style/Wrap"
                        android:gravity="center_horizontal"
                        android:textColor="@color/colorBlue"
                        android:textSize="@dimen/grade_text_size"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_today_meaning"
                        style="@style/Wrap"
                        android:layout_marginTop="16dp"
                        android:layout_marginBottom="4dp"
                        android:gravity="center_horizontal"
                        android:textSize="@dimen/grade_text_size" />
                </LinearLayout>

                <GridLayout
                    android:id="@+id/gl_option"
                    style="@style/WidthMatch"
                    android:layout_gravity="center_horizontal"
                    android:columnCount="2">

                    <LinearLayout
                        android:id="@+id/v_wordbooks_hangul"
                        android:layout_columnWeight="1"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="16dp"
                        android:gravity="center_horizontal"
                        android:orientation="vertical">

                        <ImageView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:src="@drawable/ic_wordbooks_hangul" />

                        <TextView
                            style="@style/TextViewItem"
                            android:layout_marginTop="8dp"
                            android:gravity="center_horizontal"
                            android:text="@string/tb_wordbooks_hangul" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/v_lesson_student"
                        android:layout_columnWeight="1"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="16dp"
                        android:gravity="center_horizontal"
                        android:orientation="vertical">

                        <ImageView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:src="@drawable/ic_quiz" />

                        <TextView
                            style="@style/TextViewItem"
                            android:layout_marginTop="8dp"
                            android:gravity="center_horizontal"
                            android:text="@string/tb_lessons_student_break_line" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/v_lesson_tutor"
                        android:layout_columnWeight="1"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="16dp"
                        android:gravity="center_horizontal"
                        android:orientation="vertical">

                        <ImageView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:src="@drawable/ic_practice_with_people" />

                        <TextView
                            style="@style/TextViewItem"
                            android:layout_marginTop="8dp"
                            android:gravity="center_horizontal"
                            android:text="@string/tb_lessons_tutor_break_line" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/v_wordbooks"
                        android:layout_columnWeight="1"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="16dp"
                        android:gravity="center_horizontal"
                        android:orientation="vertical">

                        <ImageView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:src="@drawable/ic_wordbooks" />

                        <TextView
                            style="@style/TextViewItem"
                            android:layout_marginTop="8dp"
                            android:gravity="center_horizontal"
                            android:text="@string/tb_wordbooks" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/v_favorites"
                        android:layout_columnWeight="1"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="16dp"
                        android:gravity="center_horizontal"
                        android:orientation="vertical">

                        <ImageView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:src="@drawable/ic_favorites" />

                        <TextView
                            style="@style/TextViewItem"
                            android:layout_marginTop="8dp"
                            android:gravity="center_horizontal"
                            android:text="@string/nav_title_favorites" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/v_targets"
                        android:layout_columnWeight="1"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="16dp"
                        android:gravity="center_horizontal"
                        android:orientation="vertical">

                        <ImageView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:src="@drawable/ic_targets" />

                        <TextView
                            style="@style/TextViewItem"
                            android:layout_marginTop="8dp"
                            android:gravity="center_horizontal"
                            android:text="@string/nav_title_targets" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/v_homework"
                        android:layout_columnWeight="1"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="16dp"
                        android:gravity="center_horizontal"
                        android:orientation="vertical">

                        <ImageView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:src="@drawable/ic_homework" />

                        <TextView
                            style="@style/TextViewItem"
                            android:layout_marginTop="8dp"
                            android:gravity="center_horizontal"
                            android:text="@string/nav_title_homework" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/v_recording_all"
                        android:layout_columnWeight="1"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="16dp"
                        android:gravity="center_horizontal"
                        android:orientation="vertical">

                        <ImageView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:src="@drawable/ic_study_history" />

                        <TextView
                            style="@style/TextViewItem"
                            android:layout_marginTop="8dp"
                            android:gravity="center_horizontal"
                            android:text="@string/nav_title_recording_all" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/v_chatting"
                        android:layout_columnWeight="1"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="16dp"
                        android:gravity="center_horizontal"
                        android:orientation="vertical">

                        <ImageView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:src="@drawable/ic_chatting" />

                        <TextView
                            style="@style/TextViewItem"
                            android:layout_marginTop="8dp"
                            android:gravity="center_horizontal"
                            android:text="@string/nav_title_chatting" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/v_practice_with_people"
                        android:layout_columnWeight="1"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="16dp"
                        android:gravity="center_horizontal"
                        android:orientation="vertical">

                        <ImageView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:src="@drawable/ic_practice_with_people" />

                        <TextView
                            style="@style/TextViewItem"
                            android:layout_marginTop="8dp"
                            android:gravity="center_horizontal"
                            android:text="@string/nav_title_practice_with_people" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/v_quiz"
                        android:layout_columnWeight="1"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="16dp"
                        android:layout_marginBottom="16dp"
                        android:gravity="center_horizontal"
                        android:orientation="vertical">

                        <ImageView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:src="@drawable/ic_quiz" />

                        <TextView
                            style="@style/TextViewItem"
                            android:layout_marginTop="8dp"
                            android:gravity="center_horizontal"
                            android:text="@string/tb_quiz" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/v_study_history"
                        android:layout_columnWeight="1"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="16dp"
                        android:layout_marginBottom="16dp"
                        android:gravity="center_horizontal"
                        android:orientation="vertical">

                        <ImageView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:src="@drawable/ic_study_history" />

                        <TextView
                            style="@style/TextViewItem"
                            android:layout_marginTop="8dp"
                            android:gravity="center_horizontal"
                            android:text="@string/tb_history" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/v_admin"
                        android:layout_columnWeight="1"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="16dp"
                        android:gravity="center_horizontal"
                        android:orientation="vertical">

                        <ImageView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:src="@drawable/ic_homework" />

                        <TextView
                            style="@style/TextViewItem"
                            android:layout_marginTop="8dp"
                            android:gravity="center_horizontal"
                            android:text="@string/admin" />
                    </LinearLayout>
                </GridLayout>
            </LinearLayout>
        </ScrollView>
    </LinearLayout>

    <com.google.android.material.navigation.NavigationView
        android:id="@+id/nav_left"
        style="@style/HeightMatch"
        android:layout_gravity="start"
        android:background="@color/home_side_menu_item_background" />
</androidx.drawerlayout.widget.DrawerLayout>
