<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/Wrap"
    android:background="@android:color/transparent">

    <LinearLayout
        style="@style/WidthMatch"
        android:layout_centerInParent="true"
        android:background="@color/color_ruby_dialog_background"
        android:orientation="vertical">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/color_ruby_dialog_header"
            android:padding="@dimen/nav_header_vertical_spacing_text">

            <TextView
                style="@style/TextView_Header"
                android:layout_gravity="center"
                android:text="@string/ruby_dialog_word_definition_title" />

            <ImageView
                android:id="@+id/ivClose"
                style="@style/ImageView_Item_Bookmark"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"
                android:layout_marginLeft="@dimen/nav_header_vertical_spacing_text"
                android:src="@drawable/ic_cancel" />
        </RelativeLayout>

        <RelativeLayout
            style="@style/WidthMatch"
            android:layout_margin="@dimen/nav_header_vertical_spacing_text">

            <LinearLayout
                style="@style/Wrap"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/ivVol"
                    style="@style/ImageView_Item_Ruby"
                    android:src="@drawable/ic_vol"/>

                <ImageView
                    android:id="@+id/ivBookmark"
                    style="@style/ImageView_Item_Ruby"
                    android:layout_marginLeft="@dimen/nav_header_vertical_spacing_text"
                    android:src="@drawable/ic_star" />

                <RelativeLayout
                    android:id="@+id/llAmkiGrade"
                    style="@style/ImageView_Item_Ruby"
                    android:layout_marginLeft="@dimen/nav_header_vertical_spacing_text"
                    android:gravity="center"
                    android:background="@drawable/circle_grey">

                    <ImageView
                        style="@style/Wrap"
                        android:padding="8dp"
                        android:src="@drawable/ic_cancel"
                        android:tint="@color/colorBlack" />
                </RelativeLayout>
            </LinearLayout>

            <LinearLayout
                style="@style/Wrap"
                android:orientation="vertical"
                android:gravity="right"
                android:layout_alignParentRight="true">

                <CheckedTextView
                    android:id="@+id/tvKnownWord"
                    style="@style/TextView_Header"
                    android:layout_width="wrap_content"
                    android:drawableRight="@drawable/ic_checkbox"
                    android:drawablePadding="5dp"
                    android:text="@string/ruby_dialog_word_definition_known_word" />

                <CheckedTextView
                    android:id="@+id/tvKnownPronounce"
                    style="@style/TextView_Header"
                    android:layout_width="wrap_content"
                    android:drawableRight="@drawable/ic_checkbox"
                    android:drawablePadding="5dp"
                    android:text="@string/ruby_dialog_word_definition_known_pronounce" />
            </LinearLayout>
        </RelativeLayout>

        <TextView
            android:id="@+id/tvWord"
            style="@style/TextView_Header"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="@dimen/nav_header_vertical_spacing_text"
            android:layout_marginBottom="@dimen/nav_header_vertical_spacing_text"
            android:textSize="15sp" />

        <LinearLayout
            android:id="@+id/llEdit"
            style="@style/WidthFill"
            android:orientation="vertical">

            <EditText
                android:id="@+id/etPronuncation"
                style="@style/EditText_Search"
                android:layout_marginLeft="@dimen/nav_header_vertical_spacing_text"
                android:layout_marginRight="@dimen/nav_header_vertical_spacing_text"
                android:background="@drawable/rect_boundary"
                android:gravity="center" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginLeft="16dp"
                android:layout_marginRight="16dp"
                android:background="@color/color_ruby_dialog_header" />

            <EditText
                android:id="@+id/etMeaning"
                style="@style/EditText_Search"
                android:layout_marginLeft="@dimen/nav_header_vertical_spacing_text"
                android:layout_marginRight="@dimen/nav_header_vertical_spacing_text"
                android:background="@drawable/rect_boundary"
                android:gravity="center" />
        </LinearLayout>

        <RelativeLayout
            style="@style/WidthMatch"
            android:layout_marginTop="20dp"
            android:background="@color/color_ruby_dialog_header"
            android:padding="@dimen/nav_header_vertical_spacing_text">

            <TextView
                android:id="@+id/studyButton"
                style="@style/ButtonRubyWhite"
                android:layout_alignParentLeft="true"
                android:text="@string/ruby_dialog_word_definition_study_button" />

            <TextView
                android:id="@+id/moreButton"
                style="@style/ButtonRubyWhite"
                android:layout_alignParentRight="true"
                android:text="@string/ruby_dialog_word_definition_more_button" />
        </RelativeLayout>
    </LinearLayout>
</RelativeLayout>