<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/WidthMatch"
    android:background="@color/color_nav_background"
    android:orientation="vertical">

    <LinearLayout
        style="@style/WidthMatch"
        android:background="@color/color_nav_background"
        android:orientation="horizontal">

        <LinearLayout
            style="@style/Wrap"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/tvVoca"
                style="@style/Wrap"
                android:textColor="@color/colorBlack"
                android:textSize="64sp" />

            <TextView
                android:id="@+id/tv_know"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:gravity="center"
                android:textColor="@color/colorBlack"
                android:textSize="@dimen/grade_text_size" />
        </LinearLayout>

        <LinearLayout
            style="@style/WidthMatch"
            android:orientation="vertical"
            android:paddingStart="0dp"
            android:paddingTop="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="16dp">

            <TextView
                android:id="@+id/tv_meaning_pronounce_hanja"
                style="@style/TextViewItem"
                android:textColor="@color/colorBlack" />

            <TextView
                android:id="@+id/tv_radical"
                style="@style/TextViewItem"
                android:layout_marginTop="4dp"
                android:textColor="@color/colorBlack" />

            <TextView
                android:id="@+id/tv_strokes"
                style="@style/TextViewItem"
                android:layout_marginTop="4dp"
                android:textColor="@color/colorBlack" />

            <LinearLayout
                style="@style/WidthMatch"
                android:layout_marginTop="4dp"
                android:orientation="horizontal">

                <LinearLayout
                    style="@style/Wrap"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tv_level"
                        style="@style/TextViewItem"
                        android:textColor="@color/colorBlack" />

                    <TextView
                        android:id="@+id/tv_type_2"
                        style="@style/TextViewItem"
                        android:layout_marginTop="4dp"
                        android:textColor="@color/colorBlack" />
                </LinearLayout>

                <LinearLayout
                    style="@style/Wrap"
                    android:layout_marginStart="16dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tv_type_1"
                        style="@style/TextViewItem"
                        android:textColor="@color/colorBlack" />

                    <TextView
                        android:id="@+id/tv_type_3"
                        style="@style/TextViewItem"
                        android:layout_marginTop="4dp"
                        android:textColor="@color/colorBlack" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/tv_common_use_korea"
                style="@style/TextViewItem"
                android:layout_marginTop="4dp"
                android:textColor="@color/colorBlack" />

            <TextView
                android:id="@+id/tv_common_use_japan"
                style="@style/TextViewItem"
                android:layout_marginTop="4dp"
                android:textColor="@color/colorBlack" />

            <TextView
                android:id="@+id/tv_pinyin"
                style="@style/TextViewItem"
                android:layout_marginTop="4dp"
                android:textColor="@color/colorBlack" />

            <TextView
                android:id="@+id/tv_kunyomi"
                style="@style/TextViewItem"
                android:layout_marginTop="4dp"
                android:textColor="@color/colorBlack" />

            <TextView
                android:id="@+id/tv_onyomi"
                style="@style/TextViewItem"
                android:layout_marginTop="4dp"
                android:textColor="@color/colorBlack" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/tv_meaning_detailed"
        style="@style/TextViewItem"
        android:layout_marginStart="16dp"
        android:textColor="@color/colorBlack" />

    <TextView
        android:id="@+id/tv_meaning_eng"
        style="@style/TextViewItem"
        android:layout_marginStart="16dp"
        android:layout_marginTop="4dp"
        android:textColor="@color/colorBlack" />

    <TextView
        android:id="@+id/tv_meaning_eng_detailed"
        style="@style/TextViewItem"
        android:layout_marginStart="16dp"
        android:layout_marginTop="4dp"
        android:textColor="@color/colorBlack" />
</LinearLayout>
