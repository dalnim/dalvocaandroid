<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/v_item"
    style="@style/ItemBase"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">

    <TextView
        android:id="@+id/tv_index"
        style="@style/TextViewSubItem"
        android:layout_marginLeft="8dp" />

    <ImageView
        android:id="@+id/iv_avatar"
        style="@style/Wrap"
        android:layout_centerVertical="true"
        android:layout_marginLeft="12dp" />

    <ImageView
        android:id="@+id/iv_action"
        style="@style/Wrap"
        android:layout_alignParentRight="true"
        android:layout_centerVertical="true"
        android:layout_marginRight="12dp" />

    <LinearLayout
        style="@style/FillRemainHorizontal"
        android:layout_marginLeft="12dp"
        android:layout_marginRight="12dp"
        android:layout_toLeftOf="@id/iv_action"
        android:layout_toRightOf="@id/iv_avatar"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_name"
            style="@style/TextViewItem" />

        <TextView
            android:id="@+id/tv_location"
            style="@style/TextViewItem"
            android:layout_marginTop="8dp" />

        <TextView
            android:id="@+id/tv_last_access_date"
            style="@style/TextViewItem"
            android:layout_marginTop="8dp" />

        <TextView
            android:id="@+id/tv_mother_tongue"
            style="@style/TextViewItem"
            android:layout_marginTop="8dp" />
    </LinearLayout>
</RelativeLayout>