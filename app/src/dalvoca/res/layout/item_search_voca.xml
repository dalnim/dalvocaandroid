<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/v_options"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/color_header_background"
    android:orientation="vertical">

    <RadioGroup
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginEnd="8dp"
        android:layout_marginStart="8dp"
        android:orientation="horizontal">

        <RadioButton
            android:id="@+id/rb_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="@string/search_in_title"
            android:textSize="12sp" />

        <RadioButton
            android:id="@+id/rb_meaning"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/search_in_meaning"
            android:textSize="12sp" />
    </RadioGroup>

    <View
        style="@style/Divider"
        android:layout_marginBottom="4dp"
        android:layout_marginEnd="12dp"
        android:layout_marginTop="4dp"
        android:background="@color/color_divider_search" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="12dp"
        android:layout_marginStart="12dp"
        android:text="@string/search_example_voca"
        android:textSize="12sp" />

    <View
        style="@style/Divider"
        android:layout_marginBottom="4dp"
        android:layout_marginEnd="12dp"
        android:layout_marginTop="4dp"
        android:background="@color/color_divider_search" />
</LinearLayout>
