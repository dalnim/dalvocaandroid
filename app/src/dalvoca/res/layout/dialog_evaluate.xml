<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/Layout_Padding"
    android:background="@android:color/transparent">

    <LinearLayout
        style="@style/Layout_Dialog"
        android:layout_centerInParent="true"
        android:orientation="vertical">

        <TextView
            style="@style/Wrap"
            android:layout_gravity="center"
            android:layout_margin="@dimen/activity_vertical_margin"
            android:gravity="center"
            android:text="@string/evaluate_student_speaking"
            android:textColor="@color/color_text"
            android:textSize="12sp" />

        <View
            style="@style/Divider"
            android:layout_marginStart="0dp"
            android:background="@color/colorBorderBackgroundDialog" />

        <RelativeLayout
            android:id="@+id/v_a"
            style="@style/WidthMatch">

            <TextView
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_centerVertical="true"
                android:layout_margin="8dp"
                android:background="@drawable/background_evaluate_grade_yes"
                android:gravity="center"
                android:textColor="@color/colorWhite"
                android:text="A"
                android:textSize="16sp" />

            <TextView
                style="@style/Wrap"
                android:layout_centerInParent="true"
                android:text="@string/speaking_excellent"
                android:textColor="@color/colorButtonOkEnable"
                android:textSize="16sp" />
        </RelativeLayout>

        <View
            style="@style/Divider"
            android:layout_marginStart="0dp" />

        <RelativeLayout
            android:id="@+id/v_b"
            style="@style/WidthMatch">

            <TextView
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_centerVertical="true"
                android:layout_margin="8dp"
                android:background="@drawable/background_evaluate_grade_yes"
                android:gravity="center"
                android:textColor="@color/colorWhite"
                android:text="B"
                android:textSize="16sp" />

            <TextView
                style="@style/Wrap"
                android:layout_centerInParent="true"
                android:text="@string/speaking_good"
                android:textColor="@color/colorButtonOkEnable"
                android:textSize="16sp" />
        </RelativeLayout>

        <View
            style="@style/Divider"
            android:layout_marginStart="0dp" />

        <RelativeLayout
            android:id="@+id/v_c"
            style="@style/WidthMatch">

            <TextView
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_centerVertical="true"
                android:layout_margin="8dp"
                android:background="@drawable/background_evaluate_grade_yes"
                android:gravity="center"
                android:textColor="@color/colorWhite"
                android:text="C"
                android:textSize="16sp" />

            <TextView
                style="@style/Wrap"
                android:layout_centerInParent="true"
                android:text="@string/speaking_not_bad"
                android:textColor="@color/colorButtonOkEnable"
                android:textSize="16sp" />
        </RelativeLayout>

        <View
            style="@style/Divider"
            android:layout_marginStart="0dp" />

        <TextView
            android:id="@+id/tv_action"
            style="@style/Button_Base"
            android:layout_width="wrap_content"
            android:layout_gravity="center"
            android:text="@string/cancel"
            android:textColor="@drawable/btn_ok_color" />
    </LinearLayout>
</RelativeLayout>
