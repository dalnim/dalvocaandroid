<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/v_item"
    style="@style/ItemBase"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingTop="@dimen/item_padding_top_bottom"
    android:paddingBottom="@dimen/item_padding_top_bottom">

    <ImageView
        android:id="@+id/ic_play"
        style="@style/Wrap"
        android:layout_centerVertical="true"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="24dp"
        android:src="@drawable/ic_volume_up_48dp" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_name"
            style="@style/TextViewItem" />

        <TextView
            android:id="@+id/tv_meaning"
            style="@style/TextViewItem"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="4dp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tv_grade_number"
        android:layout_width="26dp"
        android:layout_height="26dp"
        android:layout_marginStart="8dp"
        android:background="@drawable/bg_circle_orange"
        android:gravity="center"
        android:textSize="@dimen/item_text_size" />

    <Button
        android:id="@+id/btn_action"
        style="@style/ButtonBlue"
        android:layout_marginStart="8dp" />

    <ImageView
        android:id="@+id/ic_right"
        style="@style/Wrap"
        android:src="@drawable/ic_keyboard_arrow_right_36dp" />
</LinearLayout>
