<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/v_options"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/color_header_background"
    android:orientation="vertical"
    android:paddingTop="4dp"
    android:paddingBottom="4dp">

    <CheckBox
        android:id="@+id/cb_student_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:checked="true"
        android:text="@string/search_in_student_name"
        android:textSize="12sp" />

    <CheckBox
        android:id="@+id/cb_tutor_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:checked="true"
        android:text="@string/search_in_tutor_name"
        android:textSize="12sp" />

    <View
        style="@style/Divider"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="12dp"
        android:background="@color/color_divider_search" />
</LinearLayout>
