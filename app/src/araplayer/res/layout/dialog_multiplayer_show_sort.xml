<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/Layout_Padding"
    android:id="@+id/root"
    android:background="@android:color/transparent">

    <LinearLayout
        android:id="@+id/llMain"
        style="@style/Layout_Dialog"
        android:layout_centerInParent="true"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvTitle"
            style="@style/Wrap"
            android:layout_gravity="center"
            android:layout_margin="10dp"
            android:gravity="center"
            android:text="@string/choose"
            android:textColor="@color/color_text"
            android:textSize="12sp" />

        <View style="@style/DividerDialogThick" />

        <LinearLayout
            android:id="@+id/llSort"
            style="@style/WidthMatch"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvSort"
                style="@style/Multi_Button_Base"
                android:gravity="center"
                android:padding="@dimen/activity_vertical_margin"
                android:text="@string/sort"
                android:textColor="@drawable/btn_ok_color"

                android:textSize="16sp" />

            <View style="@style/DividerDialog" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/llEdit"
            style="@style/WidthMatch"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvEdit"
                style="@style/Multi_Button_Base"
                android:gravity="center"
                android:padding="@dimen/activity_vertical_margin"
                android:text="@string/edit"
                android:textColor="@drawable/btn_ok_color"
                android:textSize="16sp" />

            <View
                android:id="@+id/divider_tv_edit"
                style="@style/DividerDialog" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/llCreatePlaylist"
            style="@style/WidthMatch"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvCreatePlaylist"
                style="@style/Multi_Button_Base"
                android:gravity="center"
                android:padding="@dimen/activity_vertical_margin"
                android:text="@string/setting_menu_create_playlist"
                android:textColor="@drawable/btn_ok_color"
                android:textSize="16sp" />

            <View style="@style/DividerDialog" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/llDeletePlaylist"
            style="@style/WidthMatch"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvDeletePlaylist"
                style="@style/Multi_Button_Base"
                android:gravity="center"
                android:padding="@dimen/activity_vertical_margin"
                android:text="@string/setting_menu_delete_playlist"
                android:textColor="@drawable/btn_ok_color"
                android:textSize="16sp" />

            <View style="@style/DividerDialog" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/llPlaylist"
            style="@style/WidthMatch"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvPlaylist"
                style="@style/Multi_Button_Base"
                android:gravity="center"
                android:padding="@dimen/activity_vertical_margin"
                android:text="@string/setting_menu_playlist"
                android:textColor="@drawable/btn_ok_color"
                android:textSize="16sp" />

            <View style="@style/DividerDialog" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/llRefreshMediaList"
            style="@style/WidthMatch"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvRefreshMediaList"
                style="@style/Multi_Button_Base"
                android:gravity="center"
                android:padding="@dimen/activity_vertical_margin"
                android:text="@string/refresh_video_list"
                android:textColor="@drawable/btn_ok_color"
                android:textSize="16sp" />

            <View style="@style/DividerDialog" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/llShowNormalVideoFiles"
            style="@style/WidthMatch"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_show_normal_video_files"
                style="@style/Multi_Button_Base"
                android:gravity="center"
                android:padding="@dimen/activity_vertical_margin"
                android:text="@string/show_hidden_video_files"
                android:textColor="@drawable/btn_ok_color"
                android:textSize="16sp" />

            <View style="@style/DividerDialog" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/llShowHiddenVideoFiles"
            style="@style/WidthMatch"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvShowHiddenVideoFiles"
                style="@style/Multi_Button_Base"
                android:gravity="center"
                android:padding="@dimen/activity_vertical_margin"
                android:text="@string/show_normal_video_files"
                android:textColor="@drawable/btn_ok_color"
                android:textSize="16sp" />

            <View style="@style/DividerDialog" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/llRestorePlaylistBackup"
            style="@style/WidthMatch"
            android:orientation="vertical">
            <TextView
                android:id="@+id/tvRestorePlaylistBackup"
                style="@style/Multi_Button_Base"
                android:gravity="center"
                android:padding="@dimen/activity_vertical_margin"
                android:text="Restore playlist backup"
                android:textColor="@drawable/btn_ok_color"
                android:textSize="16sp"
                android:visibility="visible"/>

            <View
                style="@style/DividerDialog"/>
        </LinearLayout>

        <TextView
            android:id="@+id/tvCancel"
            style="@style/Multi_Button_Base"
            android:padding="@dimen/activity_vertical_margin"
            android:text="@string/cancel"
            android:textColor="@drawable/btn_ok_color"
            android:textStyle="bold" />
    </LinearLayout>
</RelativeLayout>
