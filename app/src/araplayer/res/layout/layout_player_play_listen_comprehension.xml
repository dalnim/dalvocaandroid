<?xml version="1.0" encoding="UTF-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/ll_listen_comprehension"
    style="@style/Match"
    android:padding="10dp">

    <com.dalread.component.TextViewOutline
        android:id="@+id/tvListenComprehensionDescription"
        style="@style/Player_text_top_fullscreen"
        android:layout_marginStart="40dp"
        android:layout_marginEnd="40dp"
        android:visibility="gone"
        tools:text="ListenComprehension"
        tools:visibility="visible" />

    <LinearLayout
        style="@style/Wrap"
        android:layout_alignParentStart="true"
        android:layout_alignParentTop="true"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/ivListenComprehensionExit"
            style="@style/ImageView_Player_Circle"
            android:layout_alignParentEnd="true"
            android:src="@drawable/ic_circle_close"
            android:visibility="visible"
            tools:visibility="visible"
            android:rotation="180"/>

    </LinearLayout>

</RelativeLayout>