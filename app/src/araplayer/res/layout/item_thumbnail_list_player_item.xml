<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/WidthMatch">

    <LinearLayout
        android:id="@+id/vForeground"
        style="@style/ItemBase"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:paddingTop="@dimen/item_padding_top_bottom"
        android:paddingBottom="@dimen/item_padding_top_bottom">

        <ImageView
            android:id="@+id/izbVideoThumbnail"
            style="@style/WidthMatch"
            android:layout_centerHorizontal="true"
            android:layout_centerVertical="true"
            android:background="@drawable/btn_no_border_black_background"
            android:padding="1dp"
            android:visibility="visible" />

        <LinearLayout
            style="@style/WidthMatch"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/tvVideoStartTime"
                style="@style/TextViewSubItem"
                android:layout_gravity="left"
                android:gravity="left"
                android:text="Time"
                android:layout_marginStart="5dp" />
        </LinearLayout>
    </LinearLayout>
</RelativeLayout>
