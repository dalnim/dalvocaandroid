<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Layout_Padding"
    android:background="@android:color/transparent">

    <LinearLayout
        style="@style/Layout_Dialog"
        android:layout_gravity="center"
        android:orientation="vertical">


        <include layout="@layout/layout_line_horizontal" />

        <ScrollView
            style="@style/Match"
            android:paddingVertical="2dp">

            <LinearLayout
                style="@style/WidthMatch"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvSignInUpMessage1"
                    style="@style/Wrap"
                    android:textSize="18sp"
                    android:layout_gravity="center"
                    android:layout_marginTop="10dp"
                    android:layout_marginStart="10dp"
                    android:layout_marginEnd="10dp"
                    android:text="@string/login_message_to_log_in_open_subtitle_1"
                    android:textColor="@color/textSignInUpMessageColor" />
                <TextView
                    android:id="@+id/tvSignInUpMessage2"
                    style="@style/Wrap"
                    android:textSize="18sp"
                    android:layout_gravity="center"
                    android:layout_margin="10dp"
                    android:text="@string/login_message_to_log_in_open_subtitle_2"
                    android:textColor="@color/color_web_url"
                    />


                <EditText
                    android:id="@+id/etMail"
                    style="@style/EditText_Main"
                    android:layout_marginLeft="@dimen/activity_vertical_margin"
                    android:layout_marginTop="5dp"
                    android:layout_marginRight="@dimen/activity_vertical_margin"
                    android:layout_marginBottom="5dp"
                    android:background="@drawable/background_edittext_center_round"
                    android:hint="@string/id"
                    android:imeOptions="actionNext"
                    android:inputType="textEmailAddress"
                    android:drawableEnd="@drawable/ic_clear"
                    />

                <EditText
                    android:id="@+id/etPassword"
                    style="@style/EditText_PassWord"
                    android:layout_marginLeft="@dimen/activity_vertical_margin"
                    android:layout_marginTop="5dp"
                    android:layout_marginRight="@dimen/activity_vertical_margin"
                    android:layout_marginBottom="5dp"
                    android:background="@drawable/background_edittext_center_round"
                    android:hint="@string/login_password"
                    android:imeOptions="actionDone"
                    android:clickable="true"
                    android:drawableEnd="@drawable/ic_clear"
                    />

                <LinearLayout
                    android:id="@+id/llLogInBody"
                    style="@style/WidthMatch"
                    android:layout_centerInParent="true"
                    android:orientation="vertical">


                    <LinearLayout
                        style="@style/Match"
                        android:layout_centerInParent="true"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/btnLogIn"
                            style="@style/Button_Base"
                            android:layout_margin="10dp"
                            android:layout_weight="1"
                            android:background="@drawable/btn_log_in_background"
                            android:text="@string/login_btn_ok"
                            android:textColor="@color/textLiteWhiteColor" />

                        <TextView
                            android:id="@+id/btnCancel"
                            style="@style/Button_Base"
                            android:layout_margin="10dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_border_4dp_gray"
                            android:text="@string/login_btn_cancel"
                            android:textColor="@color/textLiteWhiteColor" />
                    </LinearLayout>
                </LinearLayout>

            </LinearLayout>
        </ScrollView>
    </LinearLayout>
</FrameLayout>