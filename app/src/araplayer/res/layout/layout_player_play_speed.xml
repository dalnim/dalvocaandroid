<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/ll_speed"
    style="@style/Wrap"
    android:layout_alignParentEnd="true"
    android:layout_centerInParent="true"
    android:orientation="vertical"
    >

    <ImageView
        android:id="@+id/ivAudioSpeedMinus"
        style="@style/ImageView_Player_Circle"
        android:src="@drawable/ic_speed_minus" />

    <TextView
        android:id="@+id/tvAudioSpeedValue"
        style="@style/ImageView_Player_Circle"
        android:background="@drawable/ic_speed_value"
        android:textColor="@color/textPrimaryWhiteColor"
        android:gravity="center"
        android:text="1.0x" />

    <ImageView
        android:id="@+id/ivAudioSpeedPlus"
        style="@style/ImageView_Player_Circle"
        android:src="@drawable/ic_speed_plus" />
</LinearLayout>