<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Layout_Padding"
    android:background="@android:color/transparent">

    <androidx.core.widget.NestedScrollView
        style="@style/Layout_Dialog"
        android:layout_centerInParent="true">

        <LinearLayout
            style="@style/Match"
            android:orientation="vertical">

            <TextView
                style="@style/Wrap"
                android:layout_gravity="center"
                android:layout_margin="10dp"
                android:gravity="center"
                android:text="@string/all_subtitles_include"
                android:textColor="@color/textPrimaryColor"
                android:textSize="12sp" />

            <View
                style="@style/Divider"
                android:layout_marginStart="0dp"
                android:background="@color/colorBorderBackgroundDialog" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/sc_subtitle_to_hide_1_word"
                style="@style/SwitchSetting"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="5dp"
                android:checked="false"
                android:text='@string/all_subtitles_except_1_word'
                android:textColor="@color/textPrimaryColor" />

            <View
                style="@style/Divider"
                android:layout_marginStart="0dp" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/sc_subtitle_to_hide_repeated_1_word"
                style="@style/SwitchSetting"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="5dp"
                android:checked="false"
                android:text='@string/all_subtitles_except_repeated_1_word'
                android:textColor="@color/textPrimaryColor" />

            <View
                style="@style/Divider"
                android:layout_marginStart="0dp" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/sc_subtitle_to_hide_music_symbol"
                style="@style/SwitchSetting"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="5dp"
                android:checked="false"
                android:text='@string/all_subtitles_except_music_symbol'
                android:textColor="@color/textPrimaryColor" />

            <View
                style="@style/Divider"
                android:layout_marginStart="0dp" />


            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/sc_subtitle_to_hide_paired_bracket"
                style="@style/SwitchSetting"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="5dp"
                android:checked="false"
                android:text='@string/all_subtitles_except_paired_bracket'
                android:textColor="@color/textPrimaryColor" />

            <View
                style="@style/Divider"
                android:layout_marginStart="0dp" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/sc_subtitle_to_hide_all_capitals"
                style="@style/SwitchSetting"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="5dp"
                android:checked="false"
                android:text='@string/all_subtitles_except_all_capitals'
                android:textColor="@color/textPrimaryColor" />

            <View
                style="@style/Divider"
                android:layout_marginStart="0dp" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/sc_subtitle_to_hide_including_url"
                style="@style/SwitchSetting"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="5dp"
                android:checked="false"
                android:text='@string/all_subtitles_except_including_url'
                android:textColor="@color/textPrimaryColor" />

            <View
                style="@style/Divider"
                android:layout_marginStart="0dp" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/sc_subtitle_to_hide_no_study_lang_character"
                style="@style/SwitchSetting"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="5dp"
                android:checked="false"
                android:text='@string/all_subtitles_except_no_study_lang_character'
                android:textColor="@color/textPrimaryColor" />

            <View
                style="@style/Divider"
                android:layout_marginStart="0dp" />

            <LinearLayout
                style="@style/Match"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_cancel"
                    style="@style/Button_Base"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:padding="@dimen/activity_vertical_margin"
                    android:text="@string/cancel"
                    android:textColor="@color/colorRed"
                    android:textStyle="bold" />

                <include layout="@layout/layout_line_vertical" />

                <TextView
                    android:id="@+id/tv_apply"
                    style="@style/Button_Base"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:padding="@dimen/activity_vertical_margin"
                    android:text="@string/menu_apply"
                    android:textColor="@drawable/btn_ok_color"
                    android:textStyle="bold" />
            </LinearLayout>


        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</RelativeLayout>
