<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <FrameLayout
        style="@style/Match"
        android:background="@color/backgroundLightBlackColor">
        <ImageView
            android:id="@+id/ivAddVideo"
            android:layout_width="?actionBarSize"
            android:layout_height="?actionBarSize"
            android:layout_gravity="center"
            android:src="@drawable/ic_add_white_24dp" />
    </FrameLayout>

    <com.google.android.exoplayer2.ui.StyledPlayerView
        android:id="@+id/playerView"
        style="@style/Match"
        android:visibility="gone"

        app:repeat_toggle_modes="none"
        app:resize_mode="fixed_width"
        app:show_timeout="0"
        app:surface_type="texture_view"
        app:use_controller="false" />



    <ImageView
        android:id="@+id/ivPinScreen"
        style="@style/ImageView_4_buttons_In_Multi_Player"
        android:src="@drawable/twotone_push_pin_24"
        android:layout_gravity="top|start"
        tools:visibility="visible"
        tools:alpha="1"
        />

    <ImageView
        android:id="@+id/ivABRepeatOverlay"
        style="@style/ImageView_4_buttons_In_Multi_Player"
        android:src="@drawable/ic_repeat_ab"
        android:layout_gravity="top|center_horizontal"
        tools:visibility="visible"
        tools:alpha="1"/>

    <ImageView
        android:id="@+id/ivLoadRandomVideo"
        style="@style/ImageView_4_buttons_In_Multi_Player"
        android:src="@drawable/ic_refresh_circle"
        android:layout_gravity="top|end"
        tools:visibility="visible"
        tools:alpha="1"
        />

    <TextView
        android:id="@+id/tvExitFullScreen"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="8dp"
        android:background="@color/color_multi_player_menu_background_half_transparent"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:text="@string/multi_player_video_menu_exit_full_screen"
        android:textColor="@color/textPrimaryWhiteColor"
        android:textSize="14sp"
        android:visibility="gone"
        tools:visibility="visible" />

<!--    <ImageView-->
<!--        android:id="@+id/ivCloseVideo1"-->
<!--        style="@style/ImageView_4_buttons_In_Multi_Player"-->
<!--        android:src="@drawable/ic_close_video"-->
<!--        android:layout_gravity="bottom|start"-->
<!--        android:visibility="gone"-->
<!--        tools:visibility="visible"-->
<!--        tools:alpha="1"-->
<!--        />-->


