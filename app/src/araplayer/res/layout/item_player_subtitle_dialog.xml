        <RelativeLayout
            android:id="@+id/rl_dialog"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingTop="@dimen/toolbar_padding"
            android:paddingBottom="@dimen/toolbar_padding">
            <LinearLayout
                android:id="@+id/ll_dialog"
                style="@style/WidthMatch"
                android:layout_gravity="center"
                android:layout_marginTop="5dp"
                android:layout_marginLeft="10dp"
                android:layout_marginRight="10dp"
                android:orientation="vertical">


                <com.dalread.component.FuriganaView
                    android:id="@+id/fvDifficultWord"
                    style="@style/Player_Subtitle_TableView"
                    tools:text="meaning"/>

                <com.dalread.component.FuriganaView
                    android:id="@+id/fvSubtitle"
                    style="@style/Player_Subtitle_TableView"
                    tools:text="word" />

                <TextView
                    android:id="@+id/tvTimes"
                    style="@style/TextViewItem"
                    android:layout_gravity="center"
                    android:visibility="visible"
                    tools:visibility="visible"
                    tools:text="times??"/>

            </LinearLayout>

            <RelativeLayout
                style="@style/WidthMatch"
                android:layout_marginTop="5dp"
                android:layout_below="@+id/ll_dialog"
                android:padding="0dp">
                <!--        <LinearLayout-->
                <!--            style="@style/WidthMatch"-->
                <!--            android:gravity="center"-->
                <!--            android:orientation="horizontal"-->
                <!--            android:padding="5dp">-->

                <LinearLayout
                    android:id="@+id/llRecordingSubtitle"
                    style="@style/Wrap"
                    android:gravity="center"
                    android:layout_alignParentStart="true"
                    android:layout_centerInParent="true"
                    android:layout_marginLeft="10dp"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/ivRecordingSubtitle"
                        style="@style/ImageView_Player_Circle_No_Margin"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_mic_none_black_24dp" />
<!--                    <ImageView-->
<!--                        android:id="@+id/iv_bookmark"-->
<!--                        style="@style/ImageView_Player_Circle_No_Margin"-->
<!--                        android:src="@drawable/ic_subtitle"-->
<!--                        />-->
                    <TextView
                        android:id="@+id/tvIndex"
                        style="@style/TextViewSubItem2"
                        android:layout_marginLeft="5dp"
                        tools:text="1"/>

                </LinearLayout>

                <FrameLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_toStartOf="@id/llCCRepeat"
                    android:layout_toEndOf="@id/llRecordingSubtitle">

<!--                    <ImageView-->
<!--                        android:id="@+id/iv_recording_subtitle"-->
<!--                        style="@style/ImageView_Player_Circle_No_Margin"-->
<!--                        android:layout_gravity="center"-->
<!--                        android:src="@drawable/ic_mic_none_black_24dp" />-->

                </FrameLayout>

                <LinearLayout
                    android:id="@+id/llCCRepeat"
                    style="@style/Wrap"
                    android:layout_centerInParent="true"
                    android:gravity="center"
                    android:orientation="horizontal">


                    <ImageView
                        android:id="@+id/ivCCRepeat"
                        style="@style/ImageView_Player_Circle_No_Margin"
                        android:src="@drawable/ic_new_repetition_cc" />

                </LinearLayout>

                <TextView
                    android:id="@+id/tvRepeatCount"
                    style="@style/TextViewSubItem2"
                    android:layout_centerInParent="true"
                    android:layout_toRightOf="@+id/llCCRepeat"
                    android:layout_marginStart="10dp"
                    android:layout_marginEnd="10dp"
                    tools:text="1/3"/>

                <FrameLayout
                    android:id="@+id/layoutListenRecordedSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_toStartOf="@id/llKnowValue"
                    android:layout_toEndOf="@id/llCCRepeat"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <ImageView
                        android:id="@+id/ivListenRecordedSubtitle"
                        style="@style/ImageView_Player_Circle_No_Margin"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_speaker_human" />
                </FrameLayout>

                <ImageView
                    android:id="@+id/ivBookmark"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_toStartOf="@id/llKnowValue"
                    android:layout_centerInParent="true"
                    android:src="@drawable/ic_subtitle_on"
                    android:visibility="visible" />

                <LinearLayout
                    android:id="@+id/llKnowValue"
                    style="@style/Wrap"
                    android:gravity="center"
                    android:layout_alignParentEnd="true"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvKnowValue"
                        style="@style/ImageView_Player_Circle_No_Margin"
                        android:background="@drawable/bg_circle_voca_know_known"
                        android:layout_centerInParent="true"
                        android:gravity="center"
                        android:textColor="@color/colorBlack"
                        android:textSize="@dimen/grade_text_size" />

                    <ImageView
                        android:id="@+id/ivKnowPronounce"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_toRightOf="@id/tvKnowValue"
                        android:layout_centerInParent="true"
                        android:layout_marginRight="10dp"
                        android:src="@drawable/ic_unknown_pronounce" />


                </LinearLayout>
                <!--        </LinearLayout>-->

            </RelativeLayout>
        </RelativeLayout>
