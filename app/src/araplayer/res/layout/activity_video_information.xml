<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:background="@color/backgroundVideoInformationViewColor"
    style="@style/Match">

    <LinearLayout
        style="@style/Match"
        android:orientation="vertical">

        <com.dalread.component.Toolbar
            android:id="@id/header"
            style="@style/WidthMatch"
            app:leftIcon="@drawable/ic_back"
            app:rightText="@string/menu"
            app:title="@string/video_information" />

        <androidx.core.widget.NestedScrollView style="@style/WidthMatch"
            android:id="@+id/scroll_view"
            android:visibility="invisible"
            tools:visibility="visible">

            <LinearLayout
                style="@style/WidthMatch"
                android:orientation="vertical">

                <androidx.constraintlayout.widget.ConstraintLayout
                    style="@style/WidthMatch">

                    <ImageView
                        android:id="@+id/ivVideoBackdropImage"
                        style="@style/ImageView_Player_Video_Information"
                        android:scaleType="centerCrop"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <ImageView
                        android:id="@+id/btn_play"
                        android:layout_width="100dp"
                        android:layout_height="100dp"
                        android:layout_centerInParent="true"
                        android:src="@drawable/ic_play_circle_gray"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:id="@+id/msgBtnPlay"
                        style="@style/Player_Subtitle_Meaning"
                        android:layout_below="@id/btn_play"
                        android:layout_centerHorizontal="true"
                        android:layout_marginStart="20dp"
                        android:layout_marginTop="0dp"
                        android:layout_marginEnd="20dp"
                        android:maxLines="2"
                        android:text="@string/msg_button_play"
                        android:textSize="@dimen/font_video_information_play_button_desc"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/btn_play"
                        app:layout_constraintBottom_toBottomOf="@id/ivVideoBackdropImage"/>

                </androidx.constraintlayout.widget.ConstraintLayout>

                <ProgressBar
                    android:id="@+id/pbWatchDuration"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="10dp"
                    android:progress="20"
                    android:progressBackgroundTint="@android:color/transparent"
                    android:visibility="gone"
                    tools:visibility="visible" />

                <LinearLayout
                    android:id="@+id/ll_tmdb_logo"
                    style="@style/WidthMatch"
                    android:layout_marginStart="10dp"
                    android:layout_marginEnd="10dp"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/iv_bookmark"
                        style="@style/ImageView_Player_Circle_No_Margin"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_marginRight="10dp"
                        android:src="@drawable/ic_favorite_new" />

                    <ImageView
                        android:id="@+id/iv_tmdb_logo"
                        style="@style/Wrap"
                        android:layout_weight="1"
                        android:src="@drawable/ic_tmdb_logo" />

                    <LinearLayout
                        style="@style/WidthMatch"
                        android:layout_weight="1"
                        android:gravity="center|right">

                    </LinearLayout>

                    <TextView
                        android:id="@+id/tv_difficult"
                        style="@style/TextView_Value_Video_Information"
                        android:textStyle="bold"
                        android:visibility="gone"
                        tools:text="Very Hard"
                        tools:visibility="visible" />
                </LinearLayout>

                <LinearLayout
                    style="@style/WidthMatch"
                    android:layout_marginStart="10dp"
                    android:layout_marginTop="5dp"
                    android:layout_marginEnd="20dp"
                    android:gravity="end"
                    android:orientation="horizontal">
                    <TextView
                        android:id="@+id/tvDate"
                        style="@style/TextView_Value_Video_Information"
                        android:layout_marginRight="20dp"
                        tools:text="Date" />

                    <TextView
                        android:id="@+id/tv_size"
                        style="@style/TextView_Value_Video_Information"
                        android:layout_marginRight="20dp"
                        tools:text="size" />

                    <TextView
                        android:id="@+id/tvVideoDuration"
                        style="@style/TextView_Value_Video_Information"
                        android:gravity="right"
                        tools:text="duration" />

                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="horizontal">
                    <Button
                        android:id="@+id/btnWatchRewardedAd"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:backgroundTint="@color/color_watch_ad"
                        android:layout_marginStart="10dp"
                        android:text="@string/btn_watch_ads"
                        android:visibility="visible"
                        android:textSize="25dp"
                        tools:visibility="visible"
                        />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="10dp"
                        android:orientation="horizontal"
                        >

                        <TextView
                            android:id="@+id/tvSubtitleExt"
                            style="@style/TextView_Description"
                            android:layout_marginRight="5dp"
                            android:background="@color/backgroundSubtitleSMI"
                            android:paddingLeft="2dp"
                            android:paddingRight="2dp"
                            android:textColor="@color/dayNightLiteWhiteColor"
                            android:textStyle="bold"
                            android:visibility="gone"
                            tools:text="SMI"
                            tools:visibility="visible" />
                        <TextView
                            android:id="@+id/tvSubtitleExt2"
                            style="@style/TextView_Description"
                            android:background="@color/backgroundSubtitleSRT"
                            android:paddingLeft="2dp"
                            android:paddingRight="2dp"
                            android:textColor="@color/dayNightLiteWhiteColor"
                            android:textStyle="bold"
                            android:visibility="gone"
                            tools:text="SRT"
                            tools:visibility="visible" />


                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvRemainPoint"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:padding="8dp"
                        android:gravity="end"
                        android:layout_marginEnd="10dp"
                        android:text=""
                        />
                </LinearLayout>

                <HorizontalScrollView
                    android:id="@+id/horizontalScrollView1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/ll_poster"
                        style="@style/WidthMatch"
                        android:layout_height="120dp"
                        android:layout_marginStart="10dp"
                        android:layout_marginTop="10dp"
                        android:layout_marginEnd="10dp"
                        android:orientation="horizontal"
                        android:visibility="gone"
                        tools:visibility="visible">

                        <com.google.android.material.imageview.ShapeableImageView
                            android:id="@+id/iv_poster"
                            android:layout_width="80dp"
                            android:layout_height="match_parent"
                            android:layout_marginEnd="10dp"
                            android:scaleType="fitXY"
                            app:shapeAppearanceOverlay="@style/VideoThumbnailRoundedCorner"/>

                        <com.google.android.material.imageview.ShapeableImageView
                            android:id="@+id/iv_season_poster"
                            android:layout_width="80dp"
                            android:layout_height="match_parent"
                            android:layout_marginEnd="10dp"
                            android:scaleType="fitXY"
                            android:visibility="gone"
                            tools:visibility="visible"
                            app:shapeAppearanceOverlay="@style/VideoThumbnailRoundedCorner"/>

                        <com.google.android.material.imageview.ShapeableImageView
                            android:id="@+id/iv_video_backdrop_image_small"
                            android:layout_width="160dp"
                            android:layout_height="match_parent"
                            android:layout_marginEnd="10dp"
                            android:scaleType="centerCrop"
                            app:shapeAppearanceOverlay="@style/VideoThumbnailRoundedCorner"/>

                        <FrameLayout
                            android:layout_width="160dp"
                            android:layout_height="match_parent">

                            <com.google.android.material.imageview.ShapeableImageView
                                android:id="@+id/iv_trailer"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:scaleType="fitXY"
                                app:shapeAppearanceOverlay="@style/VideoThumbnailRoundedCorner"/>

                            <TextView
                                android:id="@+id/tv_trailer_text"
                                style="@style/Player_Subtitle_Meaning"
                                android:layout_gravity="top|center"
                                android:layout_marginTop="2dp"
                                android:padding="0dp"
                                android:text="Trailer"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                android:visibility="gone"
                                tools:visibility="visible" />

                            <ImageView
                                android:id="@+id/iv_trailer_play"
                                style="@style/ImageView_Player_Play_Small2"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_play_circle_gray"
                                android:visibility="gone"
                                tools:visibility="visible" />
                        </FrameLayout>


                    </LinearLayout>
                </HorizontalScrollView>

                <LinearLayout
                    android:id="@+id/llSubtitleSelector"
                    style="@style/Button_Base"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="51dp"
                    android:layout_marginStart="10dp"
                    android:layout_marginTop="10dp"
                    android:layout_marginEnd="10dp"
                    android:background="@drawable/bg_border_4dp_gray_inside_white"
                    android:gravity="center"
                    android:orientation="vertical"
                    >

                    <TextView
                        android:id="@+id/tvSubtitleSelector"
                        style="@style/TextView_Value_Video_Information_play"
                        android:layout_gravity="center"
                        android:gravity="center"
                        android:text="@string/subtitle_selector_subtitle_not_connected"
                        android:textAllCaps="false"
                        android:textColor="@color/textPrimaryColor"
                        />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvNeedToAnalyzeAgain"
                    style="@style/TextView_Value_Video_Information_Long_Text"
                    android:text="@string/need_to_analyze_again"
                    android:textColor="@color/colorRed"
                    android:textStyle="bold"
                    android:visibility="gone"
                    tools:visibility="visible" />

                <TextView
                    android:id="@+id/tv_memo"
                    style="@style/TextView_Value_Video_Information_Long_Text"
                    android:textStyle="bold"
                    android:visibility="gone"
                    tools:text="memo from a user"
                    tools:visibility="visible" />

                <TextView
                    android:id="@+id/tvKnowDescription"
                    style="@style/TextView_Value_Video_Information_Long_Text"
                    tools:text="You know 100 words out of 1000 words" />

                <TextView
                    android:id="@+id/tv_recommend_codec"
                    style="@style/TextView_Value_Video_Information_Long_Text"
                    android:textStyle="bold"
                    tools:text="(Recommended codecs are...)" />

