                <TableLayout
                    android:id="@+id/tlMusicInformation"
                    style="@style/WidthMatch"
                    android:layout_marginStart="10dp"
                    android:layout_marginTop="10dp"
                    android:layout_marginEnd="10dp">

                    <TableRow
                        android:id="@+id/tbDisplayTitle"
                        android:visibility="gone"
                        tools:visibility="visible">

                        <TextView
                            style="@style/TextView_Value_Video_Information_tb_title"
                            android:layout_marginRight="30dp"
                            android:text="@string/title_to_display"
                            />

                        <TextView
                            android:id="@+id/tvDisplayTitle"
                            style="@style/TextView_Value_Video_Information_tb_value"
                            android:layout_weight="1"
                            tools:text='title_to_display'/>
                    </TableRow>

                    <TableRow
                        android:id="@+id/tbTtsTitle"
                        android:visibility="gone"
                        tools:visibility="visible">

                        <TextView
                            style="@style/TextView_Value_Video_Information_tb_title"
                            android:layout_marginRight="30dp"
                            android:text="@string/title_to_play_by_tts"
                            tools:text='tts title'/>

                        <TextView
                            android:id="@+id/tvTtsTitle"
                            style="@style/TextView_Value_Video_Information_tb_value"
                            android:layout_weight="1"
                            android:textStyle="bold"
                            tools:text="title to play by TTS"/>
                    </TableRow>

                    <TableRow
                        android:id="@+id/tbArtist"
                        android:visibility="gone"
                        tools:visibility="visible">

                        <TextView
                            style="@style/TextView_Value_Video_Information_tb_title"
                            android:layout_marginRight="30dp"
                            android:text="@string/artist" />

                        <TextView
                            android:id="@+id/tvArtist"
                            style="@style/TextView_Value_Video_Information_tb_value"
                            android:layout_weight="1"
                            android:text="@string/artist"/>
                    </TableRow>

                    <TableRow
                        android:id="@+id/tbTtsArtist"
                        android:visibility="gone"
                        tools:visibility="visible">

                        <TextView
                            style="@style/TextView_Value_Video_Information_tb_title"
                            android:layout_marginRight="30dp"
                            android:text="@string/artist_to_play_by_tts"
                            tools:text='tts Artist'/>

                        <TextView
                            android:id="@+id/tvTtsArtist"
                            style="@style/TextView_Value_Video_Information_tb_value"
                            android:layout_weight="1"
                            android:textStyle="bold"
                            tools:text="Artist to play by TTS"/>
                    </TableRow>

                    <TableRow
                        android:id="@+id/tbAlbum"
                        android:visibility="gone"
                        tools:visibility="visible">

                        <TextView
                            style="@style/TextView_Value_Video_Information_tb_title"
                            android:layout_marginRight="30dp"
                            android:text="@string/album" />

                        <TextView
                            android:id="@+id/tvAlbum"
                            style="@style/TextView_Value_Video_Information_tb_value"
                            android:layout_weight="1"
                            tools:text="@string/album"/>
                    </TableRow>


                </TableLayout>

                <TableLayout
                    android:id="@+id/tl_information"
                    style="@style/WidthMatch"
                    android:layout_marginStart="10dp"
                    android:layout_marginTop="10dp"
                    android:layout_marginEnd="10dp">

                    <TableRow
                        android:id="@+id/tb_title"
                        android:visibility="gone"
                        tools:visibility="visible">

                        <TextView
                            style="@style/TextView_Value_Video_Information_tb_title"
                            android:layout_marginRight="30dp"
                            android:text="@string/title"
                            tools:text='title'/>

                        <TextView
                            android:id="@+id/tv_title_info"
                            style="@style/TextView_Value_Video_Information_tb_value"
                            android:layout_weight="1"
                            android:textStyle="bold"
                            tools:text='Buffaloed'/>
                    </TableRow>

                    <TableRow
                        android:id="@+id/tb_release_date"
                        android:visibility="gone"
                        tools:visibility="visible">

                        <TextView
                            style="@style/TextView_Value_Video_Information_tb_title"
                            android:layout_marginRight="30dp"
                            android:text="@string/release_date"
                            />

                        <TextView
                            android:id="@+id/tv_release_date"
                            style="@style/TextView_Value_Video_Information_tb_value"
                            android:layout_weight="1"
                            tools:text='1999-03-30'/>
                    </TableRow>

                    <TableRow
                        android:id="@+id/tb_seasons"
                        android:visibility="gone"
                        tools:visibility="visible">

                        <TextView
                            style="@style/TextView_Value_Video_Information_tb_title"
                            android:layout_marginRight="30dp"
                            android:text="@string/seasons" />

                        <TextView
                            android:id="@+id/tv_seasons"
                            style="@style/TextView_Value_Video_Information_tb_value"
                            android:layout_weight="1"
                            android:text="@string/seasons"/>
                    </TableRow>

                    <TableRow
                        android:id="@+id/tb_episodes"
                        android:visibility="gone"
                        tools:visibility="visible">

                        <TextView
                            style="@style/TextView_Value_Video_Information_tb_title"
                            android:layout_marginRight="30dp"
                            android:text="@string/episodes" />

                        <TextView
                            android:id="@+id/tv_episodes"
                            style="@style/TextView_Value_Video_Information_tb_value"
                            android:layout_weight="1"
                            tools:text="@string/episodes"/>
                    </TableRow>

                    <TableRow
                        android:id="@+id/tb_director"
                        android:visibility="gone"
                        tools:visibility="visible">

                        <TextView
                            style="@style/TextView_Value_Video_Information_tb_title"
                            android:layout_marginRight="30dp"
                            android:text="@string/director" />

                        <TextView
                            android:id="@+id/tv_director"
                            style="@style/TextView_Value_Video_Information_tb_value"
                            android:layout_weight="1"
                            tools:text="@string/director"/>
                    </TableRow>

                    <TableRow
                        android:id="@+id/tb_writer"
                        android:visibility="gone"
                        tools:visibility="visible">

                        <TextView
                            style="@style/TextView_Value_Video_Information_tb_title"
                            android:layout_marginRight="30dp"
                            android:text="@string/writer" />

                        <TextView
                            android:id="@+id/tv_writer"
                            style="@style/TextView_Value_Video_Information_tb_value"
                            android:layout_weight="1"
                            tools:text="@string/writer"/>
                    </TableRow>

                    <TableRow
                        android:id="@+id/tb_cast"
                        android:visibility="gone"
                        tools:visibility="visible">

                        <TextView
                            style="@style/TextView_Value_Video_Information_tb_title"
                            android:layout_marginRight="30dp"
                            android:text="@string/cast" />

                        <TextView
                            android:id="@+id/tv_cast"
                            style="@style/TextView_Value_Video_Information_tb_value"
                            android:layout_weight="1"
                            tools:text="@string/cast"/>
                    </TableRow>

                    <TableRow
                        android:id="@+id/tb_genre"
                        android:visibility="gone"
                        tools:visibility="visible">

                        <TextView
                            style="@style/TextView_Value_Video_Information_tb_title"
                            android:layout_marginRight="30dp"
                            android:text="@string/genre" />

                        <TextView
                            android:id="@+id/tv_genre"
                            style="@style/TextView_Value_Video_Information_tb_value"
                            android:layout_weight="1"
                            tools:text="@string/genre"/>
                    </TableRow>

                    <TableRow
                        android:id="@+id/tb_resolution"
                        android:visibility="gone">

                        <TextView
                            style="@style/TextView_Value_Video_Information_tb_title"
                            android:layout_marginRight="30dp"
                            android:text="@string/resolution" />

                        <TextView
                            android:id="@+id/tv_resolution"
                            style="@style/TextView_Value_Video_Information_tb_value"
                            android:layout_weight="1" />
                    </TableRow>

                    <TableRow
                        android:id="@+id/tb_codec"
                        android:visibility="gone">

                        <TextView
                            style="@style/TextView_Value_Video_Information_tb_title"
                            android:layout_marginRight="30dp"
                            android:text="@string/codec" />

                        <TextView
                            android:id="@+id/tv_codec"
                            style="@style/TextView_Value_Video_Information_tb_value"
                            android:layout_weight="1" />
                    </TableRow>
                </TableLayout>

                <TextView
                    android:id="@+id/tvCast"
                    style="@style/TextView_Value_Video_Information"
                    android:layout_gravity="left"

                    android:layout_marginStart="10dp"
                    android:layout_marginEnd="10dp"

                    android:text="@string/cast"
                    android:textColor="@color/textPrimaryColor"
                    android:visibility="gone"
                    tools:visibility="visible" />


                <com.dalread.component.ClickableRecyclerView
                    android:id="@+id/rvListCredits"
                    style="@style/WidthMatch"
                    android:layout_gravity="center"
                    android:clipToPadding="false"
                    android:padding="10dp"
                    app:layoutManager="androidx.recyclerview.widget.StaggeredGridLayoutManager"
                    tools:itemCount="1"
                    tools:listitem="@layout/item_cast_profile"/>

                <LinearLayout
                    android:id="@+id/llAnalyzeAgain"
                    style="@style/Button_Base"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="51dp"
                    android:layout_marginStart="10dp"

                    android:layout_marginEnd="10dp"
                    android:background="@drawable/bg_border_4dp_gray"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <TextView
                        android:id="@+id/tv_refresh_and_watch"
                        style="@style/TextView_Value_Video_Information_play"
                        android:layout_gravity="center"
                        android:gravity="center"
                        android:text="@string/refresh_and_watch"
                        android:textAllCaps="false"
                        android:textColor="@color/textVeryLiteWhiteColor"
                        android:textStyle="bold"
                        android:visibility="visible" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/ll_description"
                    style="@style/WidthMatch"
                    android:layout_marginTop="10dp"
                    android:orientation="vertical"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <TextView
                        style="@style/TextView_Value_Video_Information_detail"
                        android:layout_gravity="center"
                        android:text="@string/video_overview"
                        android:textStyle="bold" />

                    <com.dalread.component.ReadMoreTextView
                        android:id="@+id/tvDescription"
                        style="@style/TextView_Value_Video_Information_detail"
                        app:trimMode="trimModeLine"
                        app:trimLines="5"
                        app:colorClickableText="@color/textReadMoreColor"
                        app:showTrimExpandedText="true"
                        app:textIsSelectable="true"
                        app:enableTrimMode="true"
                        tools:text="detailed overview information" />
                </LinearLayout>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </LinearLayout>

