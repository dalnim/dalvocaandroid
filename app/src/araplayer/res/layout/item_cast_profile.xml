<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/ll_item"
    style="@style/ImageView_Caster_Video_Information"
    android:layout_gravity="center"
    android:orientation="vertical"
    app:cardBackgroundColor="@color/backgroundColor"
    app:cardCornerRadius="@dimen/card_corner_radius">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">


        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/izb_profile"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:scaleType="center"
            android:src="@mipmap/ic_no_avatar"
            app:layout_constraintBottom_toTopOf="@+id/ll_cast_name"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:shapeAppearanceOverlay="@style/VideoThumbnailRoundedCorner" />

        <LinearLayout
            android:id="@+id/ll_cast_name"
            android:layout_width="0dp"
            android:layout_height="100dp"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"
            android:orientation="vertical"
            android:weightSum="2"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <TextView
                android:id="@+id/tv_real_name"
                style="@style/TextView_Cast_Name_Profile"

                android:gravity="center_vertical"
                android:ellipsize="none"
                android:lineSpacingMultiplier="0.8"
                android:maxLines="2"
                android:layout_weight="1"
                tools:text="real name real name real name real name real name" />

            <TextView
                android:id="@+id/tv_character_name"
                style="@style/TextView_Character_name"
                android:gravity="center_vertical"
                android:lineSpacingMultiplier="0.8"
                android:maxLines="2"
                android:layout_weight="1"
                tools:text="character name character name character name character name" />
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.cardview.widget.CardView>