<?xml version="1.0" encoding="UTF-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/WidthMatch"
    android:background="@color/backgroundRectangleOverPlayingScreenForPlayIconsColor"
    android:orientation="vertical">



    <LinearLayout
        style="@style/WidthMatch"
        android:layout_height="150dp"
        android:orientation="horizontal"
        android:textColor="?android:attr/textColorPrimary"
        android:background="@color/backgroundVideoSeasonColor"
        >
        <ImageView
            android:id="@+id/ivPoster"
            android:layout_width="90dp"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:layout_margin="10dp"
            android:scaleType="fitCenter"
            android:visibility="invisible"
            tools:visibility="visible"
            />
        <ImageView
            android:id="@+id/ivSeasonPoster"
            android:layout_width="90dp"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:layout_margin="10dp"
            android:scaleType="fitCenter"
            android:visibility="invisible"
            tools:visibility="visible"
            />
        <LinearLayout
            style="@style/WidthMatch"
            android:layout_marginTop="5dp"
            android:layout_weight="1"
            android:orientation="vertical"
            >
            <TextView
                android:id="@+id/tvSeasonTitle"
                style="@style/TextView_Value_Video_Information"
                android:layout_gravity="center|top"
                android:textStyle="bold"
                android:textIsSelectable="true"
                android:text="season title"/>

        </LinearLayout>
    </LinearLayout>

</LinearLayout>