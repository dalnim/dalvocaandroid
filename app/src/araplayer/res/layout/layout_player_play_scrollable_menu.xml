<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/llScrollableMenuList"
    style="@style/Wrap"
    android:layout_alignParentEnd="true"
    android:layout_centerInParent="true"
    android:orientation="vertical">
    <LinearLayout
        style="@style/Wrap"
        android:layout_marginEnd="60dp"
        android:orientation="horizontal">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_scrollable_menu"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/layout_btn_left"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:orientation="horizontal"
            android:overScrollMode="never"
            android:paddingHorizontal="@dimen/activity_horizontal_margin_item"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            tools:listitem="@layout/item_scrollable_menu_in_player" />

        <ImageView
            android:id="@+id/ivScollableMenuRightArrow"
            android:layout_width="@dimen/scrollable_menu_icon_size"
            android:layout_height="@dimen/scrollable_menu_icon_size"
            android:layout_marginStart="5dp"
            android:layout_marginTop="10dp"
            android:src="@drawable/ic_arrow_right" />
    </LinearLayout>
</LinearLayout>