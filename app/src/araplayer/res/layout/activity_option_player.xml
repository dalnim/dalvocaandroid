                <LinearLayout
                    android:id="@+id/llSaveSubtitle"
                    style="@style/TextView_Player_Option_Layout_Item"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/TextView_Title"
                        android:layout_gravity="center_vertical"
