                        android:gravity="right"
                        android:text="AUTO" />

                    <ImageView
                        style="@style/ImageView_Item_Movie"
                        android:src="@drawable/ic_keyboard_arrow_right_36dp" />
                </LinearLayout>

                <include layout="@layout/layout_line_horizontal_small" />

                <LinearLayout
                    android:id="@+id/llCopySubTitle2"
                    style="@style/TextView_Player_Option_Layout_Item"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/TextView_Title"
                        android:layout_gravity="center_vertical"
                        android:layout_weight="1"
                        android:text="@string/copy_subtitle_2_all_content" />

                    <ImageView
                        style="@style/ImageView_Item_Movie"
                        android:src="@drawable/ic_keyboard_arrow_right_36dp" />
                </LinearLayout>

            </LinearLayout>


            <TextView
                style="@style/TextView_Player_Option_Sub_Header"
                android:text="@string/etc" />

