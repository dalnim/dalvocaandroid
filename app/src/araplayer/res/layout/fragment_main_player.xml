                    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
                        android:id="@+id/pull_to_refresh"
                        style="@style/Match"
                        android:layout_weight="1"
                        android:background="@color/backgroundColorOutOfTable">

                        <me.zhanghai.android.fastscroll.FastScrollScrollView
                            android:id="@+id/fssv_preview"
                            style="@style/WidthMatch"

                            android:fillViewport="true"
                            android:background="@drawable/background_table_view">

                            <FrameLayout
                                style="@style/Match"
                                android:orientation="vertical"
                                android:background="@drawable/background_table_view">

                                <androidx.recyclerview.widget.RecyclerView
                                    android:id="@+id/rvContent"
                                    style="@style/Match"
                                    android:background="@drawable/background_table_view"
                                    android:visibility="visible"
                                    tools:visibility="visible"
                                    tools:itemCount="1"
                                    tools:listitem="@layout/item_player_list"
                                    />
                                <TextView
                                    android:id="@+id/tvNoDataVideoFiles"
                                    style="@style/HeightMatch"
                                    android:layout_gravity="center"
                                    android:layout_marginStart="10dp"
                                    android:layout_marginEnd="10dp"
                                    android:gravity="center"
                                    android:text="@string/no_data_video_files"
                                    android:textColor="@color/textPrimaryColor"
                                    android:textSize="@dimen/font_title"
                                    android:visibility="gone"
                                    tools:visibility="visible"/>
                            </FrameLayout>
                        </me.zhanghai.android.fastscroll.FastScrollScrollView>


                    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

