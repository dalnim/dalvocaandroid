<?xml version="1.0" encoding="UTF-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    style="@style/Match"
    android:visibility="visible"
    tools:visibility="visible">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/llMainMultiplePlayerFragment"
        style="@style/Match"
        android:orientation="vertical"
        android:visibility="gone"
        android:paddingBottom="0dp"
        tools:visibility="gone">

        <Button
            android:id="@+id/btnWatchRewardedAd"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:backgroundTint="@color/color_watch_ad"
            android:layout_gravity="center"
            android:layout_marginBottom="48dp"
            android:text="@string/btn_watch_ads"
            android:textSize="@dimen/font_multiplayer_screen_button"
            app:layout_constraintBottom_toTopOf="@+id/tvRemainPoint"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <TextView
            android:id="@+id/tvRemainPoint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="8dp"
            android:layout_marginBottom="8dp"
            android:gravity="center"
            android:visibility="visible"
            android:text="100 Points"
            app:layout_constraintBottom_toTopOf="@+id/llCenterButtons"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"  />


        <LinearLayout
            android:id="@+id/llCenterButtons"
            style="@style/WidthMatch"
            android:orientation="vertical"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">
            <Button
                android:id="@+id/btnScreenCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@android:color/transparent"
                android:textColor="@color/colorBlue"
                android:layout_gravity="center"
                android:layout_marginBottom="32dp"
                android:text="@string/multi_player_watch_video"
                android:textSize="@dimen/font_multiplayer_screen_count"
                app:layout_constraintBottom_toTopOf="@+id/btnWatchVideo"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                />


            <Button
                android:id="@+id/btnWatchVideo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="@string/multi_player_watch_video"
                android:textSize="@dimen/font_multiplayer_screen_button"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                />
        </LinearLayout>


        <ImageView
            android:id="@+id/ivClearMultiScreenHistory"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginTop="32dp"
            app:layout_constraintTop_toBottomOf="@+id/llCenterButtons"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:srcCompat="@drawable/ic_delete_black_24dp" />

        <ImageView
            android:id="@+id/ivSetPoint0"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginTop="32dp"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="@+id/llCenterButtons"
            app:layout_constraintStart_toEndOf="@+id/ivClearMultiScreenHistory"
            app:layout_constraintTop_toBottomOf="@+id/llCenterButtons"
            app:srcCompat="@drawable/ic_download_circle"
            tools:visibility="visible" />

        <FrameLayout
            android:id="@+id/adViewContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:layout_centerInParent="true"
            android:layout_gravity="center"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" >

        </FrameLayout>

