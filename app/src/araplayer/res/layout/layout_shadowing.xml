<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clickable="true"
    android:focusable="true"
    android:visibility="gone"
    tools:visibility="visible">

    <RelativeLayout
        android:id="@+id/layout_recording_and_listening"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        tools:visibility="visible">

        <TextView
            android:id="@+id/tvTitle"
            style="@style/Player_Subtitle_Meaning"
            android:layout_above="@id/layoutImage"

            android:textSize="@dimen/font_player_text_top_fullscreen"
            tools:text="@string/recording"/>

        <ImageView
            android:id="@+id/ivCloseShadowing"
            style="@style/ImageView_Player"
            android:layout_alignParentEnd="true"
            android:layout_margin="@dimen/activity_vertical_margin_two"
            android:src="@drawable/ic_circle_close" />

        <FrameLayout
            android:id="@+id/layoutImage"
            android:layout_width="@dimen/layout_shadowing_size"
            android:layout_height="@dimen/layout_shadowing_size"
            android:layout_centerInParent="true"
            android:background="@color/transparent">

            <ImageView
                android:id="@+id/ivListeningVideoVoice"
                style="@style/Match"
                android:src="@drawable/ic_shadow_listening_video_voice" />

            <ImageView
                android:id="@+id/ivRecording"
                style="@style/Match"
                android:src="@drawable/ic_shadow_recording_my_voice"
                android:visibility="gone" />


            <ImageView
                android:id="@+id/ivListeningMyVoice"
                style="@style/Match"
                android:src="@drawable/ic_shadow_listening_my_voice"
                android:visibility="gone" />

        </FrameLayout>

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/pb_recording_count_down"
            style="@style/WidthMatch"
            android:layout_below="@id/layoutImage"
            android:layout_alignStart="@id/layoutImage"
            android:layout_alignEnd="@id/layoutImage"
            android:layout_marginTop="5dp"
            android:progress="100"
            app:trackThickness="@dimen/progress_recording_count_down_height" />

        <TextView
            android:id="@+id/tvRecordingTapToFinish"
            style="@style/Player_Subtitle_Meaning"
            android:textSize="@dimen/font_player_subtitle_prev_next_2"
            android:layout_below="@id/pb_recording_count_down"
            android:layout_marginBottom="5dp"
            android:text="@string/recording_tap_to_stop"
            />

    </RelativeLayout>


</RelativeLayout>