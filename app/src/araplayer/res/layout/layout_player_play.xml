<?xml version="1.0" encoding="UTF-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    style="@style/Match"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/llPlayTopMenu"
        style="@style/WidthMatch"
        android:layout_alignParentTop="true"
        android:background="@color/backgroundRectangleOverPlayingScreenForPlayIconsColor"
        android:gravity="center"
        android:orientation="horizontal">

        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@color/color_player_play_top_btn_background">

            <ImageView
                android:id="@+id/ivBack"
                style="@style/ImageView_Player"
                android:src="@drawable/ic_back" />

        </FrameLayout>

        <RelativeLayout
            style="@style/Match"
            android:layout_weight="1">

            <androidx.appcompat.widget.AppCompatSeekBar
                android:id="@+id/sbPlayer"
                style="@style/PlayerSeekBar"
                android:maxHeight="50dp" />

            <TextView
                android:id="@+id/tvVideoStartTime"
                android:layout_width="50dp"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:layout_gravity="center_vertical"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:gravity="center|left"
                android:lines="1"
                android:textColor="@color/textPrimaryWhiteColor"
                app:autoSizeMaxTextSize="14sp"
                app:autoSizeMinTextSize="10sp"
                app:autoSizeStepGranularity="2sp"
                app:autoSizeTextType="uniform"
                tools:text="00:00:00" />

            <TextView
                android:id="@+id/tvVideoEndTime"
                android:layout_width="50dp"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:layout_gravity="center_vertical"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:gravity="center|right"
                android:lines="1"
                android:textColor="@color/textPrimaryWhiteColor"
                app:autoSizeMaxTextSize="14sp"
                app:autoSizeMinTextSize="10sp"
                app:autoSizeStepGranularity="2sp"
                app:autoSizeTextType="uniform"
                tools:text="00:00:00" />

            <com.dalread.component.TextViewOutline
                android:id="@+id/tvMediaTitle"
                style="@style/Player_text_top_fullscreen"
                android:layout_centerVertical="true"
                android:layout_toStartOf="@id/tvVideoEndTime"
                android:layout_toEndOf="@id/tvVideoStartTime"
                android:ellipsize="marquee"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:marqueeRepeatLimit="marquee_forever"
                android:textColor="@color/textPrimaryWhiteColor"
                android:padding="0dp"
                android:singleLine="true"
                tools:text="vide file name"/>

            <com.jaygoo.widget.RangeSeekBar
                android:id="@+id/sbPlay"
                style="@style/Match"
                android:layout_weight="1"
                android:visibility="gone"
                app:rsb_gravity="center"
                app:rsb_mode="single" />

        </RelativeLayout>

        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@color/color_player_play_top_btn_background">

            <ImageView
                android:id="@+id/ivMenu"
                style="@style/ImageView_Player"
                android:src="@drawable/ic_more_horiz_black_24dp"
                app:tint="@color/backgroundWhiteColor" />
        </FrameLayout>

    </LinearLayout>

    <RelativeLayout
        android:id="@+id/layout_btn_left"
        style="@style/Wrap"
        android:layout_alignParentLeft="true"
        android:layout_centerInParent="true"
        android:layout_weight="1"
        android:orientation="vertical"
        android:padding="10dp">

        <LinearLayout
            android:id="@+id/llPlayerAsync"
            style="@style/Wrap"
            android:layout_alignParentLeft="true"
            android:orientation="vertical">

            <include
                android:id="@+id/layout_player_play_scrollable_menu"
                layout="@layout/layout_player_play_scrollable_menu" />
            <!--            <LinearLayout-->
            <!--                style="@style/Wrap"-->
            <!--                android:layout_marginEnd="60dp"-->
            <!--                android:orientation="horizontal">-->

            <!--                <androidx.recyclerview.widget.RecyclerView-->
            <!--                    android:id="@+id/rv_scrollable_menu"-->
            <!--                    android:layout_width="wrap_content"-->
            <!--                    android:layout_height="wrap_content"-->
            <!--                    android:layout_below="@+id/layout_btn_left"-->
            <!--                    android:layout_weight="1"-->
            <!--                    android:clipToPadding="false"-->
            <!--                    android:orientation="horizontal"-->
            <!--                    android:overScrollMode="never"-->
            <!--                    android:paddingHorizontal="@dimen/activity_horizontal_margin_item"-->
            <!--                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"-->
            <!--                    tools:listitem="@layout/item_scrollable_menu_in_player" />-->

            <!--                <ImageView-->
            <!--                    android:id="@+id/ivScollableMenuRightArrow"-->
            <!--                    style="@style/Wrap"-->
            <!--                    android:layout_marginStart="5dp"-->
            <!--                    android:layout_marginTop="10dp"-->
            <!--                    android:src="@drawable/ic_keyboard_arrow_right_36dp" />-->
            <!--            </LinearLayout>-->

            <ImageView
                android:id="@+id/ivShowHideTableview"
                style="@style/ImageView_Player_Subtitle_Show_Hide"
                android:layout_marginTop="5dp"
                android:src="@drawable/ic_subtitle_table_hide"
                android:tag="@drawable/ic_subtitle_table_hide" />
        </LinearLayout>
    </RelativeLayout>

    <LinearLayout
        android:id="@+id/llPlayBottomMenu"
        style="@style/WidthMatch"
        android:layout_alignParentBottom="true"
        android:background="@color/backgroundRectangleOverPlayingScreenForPlayIconsColor"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/ivScreenResize"
            style="@style/ImageView_Player"
            android:layout_weight="1"
            android:src="@drawable/ic_screen_zoom_out" />

        <ImageView
            android:id="@+id/ivAdjustSubtitleFontSize"
            style="@style/ImageView_Player"
            android:layout_weight="1"
            android:src="@drawable/ic_font_resize" />

        <ImageView
            android:id="@+id/ivPreviousSong"
            style="@style/ImageView_Player"
            android:layout_weight="1"
            android:src="@drawable/ic_baseline_skip_previous_24"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/ivShuffle"
            style="@style/ImageView_Player"
            android:layout_weight="1"
            android:src="@drawable/ic_shuffle"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/ivBackward"
            style="@style/ImageView_Player"
            android:layout_weight="1"
            android:src="@drawable/ic_backward_3_sec" />

        <ImageView
            android:id="@+id/ivPlay"
            style="@style/ImageView_Player"
            android:layout_weight="1"
            android:src="@drawable/ic_new_play" />

        <ImageView
            android:id="@+id/ivForward"
            style="@style/ImageView_Player"
            android:layout_weight="1"
            android:src="@drawable/ic_forward_3_sec" />

        <ImageView
            android:id="@+id/ivRepeatSong"
            style="@style/ImageView_Player"
            android:layout_weight="1"
            android:src="@drawable/ic_repeat_song"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/ivNextSong"
            style="@style/ImageView_Player"
            android:layout_weight="1"
            android:src="@drawable/ic_baseline_skip_next_24"
            android:visibility="visible" />

        <ImageView
            android:id="@+id/ivSubtitleLangChoose"
            style="@style/ImageView_Player"
            android:layout_weight="1"
            android:src="@drawable/ic_subtitle_lang_both" />

        <ImageView
            android:id="@+id/ivZoom"
            style="@style/ImageView_Player"
            android:layout_weight="1"
            android:src="@drawable/ic_capture_screen"
            android:visibility="gone"
            tools:visibility="visible" />

        <ImageView
            android:id="@+id/ivLock"
            style="@style/ImageView_Player"
            android:layout_weight="1"
            android:src="@drawable/ic_lock_on" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/layoutBtnCenterAraMusic"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_centerInParent="true"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:layout_above="@id/llPlayBottomMenu"
        android:visibility="gone">

        <include
            android:id="@+id/layout_scrollable_menu_ara_music"
            layout="@layout/layout_player_play_scrollable_menu" />

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_select_lyric"
                style="@style/Wrap"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:layout_marginStart="10dp"
                android:text="Lyric" />

            <LinearLayout
                style="@style/WidthMatch"
                android:layout_centerInParent="true"
                android:layout_toStartOf="@id/ivShowButtonsRepetitionByAbRight"
                android:layout_toEndOf="@id/btn_select_lyric"
                android:orientation="vertical"
                android:paddingHorizontal="@dimen/activity_horizontal_margin_item">

                <TextView
                    android:id="@+id/tv_title"
                    style="@style/WidthMatch"
                    android:ellipsize="marquee"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:gravity="center"
                    android:marqueeRepeatLimit="marquee_forever"
                    android:singleLine="true"
                    android:textColor="@color/white" />

                <TextView
                    android:id="@+id/tv_artist"
                    style="@style/WidthMatch"
                    android:gravity="center"
                    android:textColor="@color/white" />
            </LinearLayout>

            <ImageView
                android:id="@+id/ivShowButtonsRepetitionByAbRight"
                style="@style/ImageView_Player_Circle_No_Margin_Buttons_On_Full_Screen"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:src="@drawable/ic_repeat_ab" />
        </RelativeLayout>
    </LinearLayout>

    <include
        android:id="@+id/layout_player_play_speed"
        layout="@layout/layout_player_play_speed" />
</RelativeLayout>
