<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/llPlaylist"
    style="@style/WidthMatch"
    android:background="?selectableItemBackground"
    android:padding="@dimen/padding_icon_header"
    android:textColor="@color/textPrimaryColor">

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/ivIcon"
        style="@style/PlaylistPopupIcon"
        android:layout_alignParentStart="true"
        android:src="@drawable/ic_music_note" />

    <androidx.appcompat.widget.AppCompatTextView

        android:id="@+id/tvPlaylistName"
        style="@style/WidthMatch"
        android:layout_marginStart="@dimen/padding_icon_header"
        android:layout_toStartOf="@id/ivEdit"
        android:layout_toEndOf="@id/ivIcon"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:maxLines="1"
        android:textColor="@color/textPrimaryColor" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tvTotalSong"
        style="@style/WidthMatch"
        android:layout_below="@id/tvPlaylistName"
        android:layout_alignStart="@id/tvPlaylistName"
        android:layout_alignEnd="@id/tvPlaylistName"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:maxLines="1"
        android:textColor="@color/textSecondaryColor" />

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/ivEdit"
        style="@style/PlaylistPopupIcon"
        android:layout_alignParentEnd="true"
        android:background="?selectableItemBackground"
        android:src="@drawable/ic_more_vert_white_24dp"
        android:tint="@color/textPrimaryColor" />

</RelativeLayout>