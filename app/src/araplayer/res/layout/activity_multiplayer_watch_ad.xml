<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/multiPrimaryDarkColor"
    android:fitsSystemWindows="true">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@android:color/black"
        android:elevation="4dp"
        android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar"
        app:popupTheme="@style/ThemeOverlay.AppCompat.Light" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="24dp">

        <TextView
            android:id="@+id/tvRemainPoint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="32dp"
            android:gravity="center"
            android:padding="8dp"
            android:text="100 Points"
            android:textColor="@color/textPrimaryWhiteColor"
            android:visibility="visible"
            app:layout_constraintBottom_toTopOf="@+id/btnWatchRewardedAd"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <Button
            android:id="@+id/btnWatchRewardedAd"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:backgroundTint="@color/multiPlayerBackgroundLightBlackColor"
            android:paddingHorizontal="32dp"
            android:paddingVertical="8dp"
            android:text="@string/btn_watch_ads"
            android:textSize="@dimen/font_multiplayer_screen_button"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <Button
            android:id="@+id/btnRewardCodeInput"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:backgroundTint="@color/multiPlayerBackgroundLightBlackColor"
            android:paddingHorizontal="32dp"
            android:paddingVertical="16dp"
            android:text="Reward Code Input"
            android:textColor="@color/textPrimaryWhiteColor"
            android:textSize="18sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.575"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/btnWatchRewardedAd" />

        <TextView
            android:id="@+id/tvFreeRewardCodeUrl"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="무료 리워드 코드 받기"
            android:textColor="#4285F4"
            android:textSize="16sp"
            android:textStyle="bold"
            android:padding="8dp"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:autoLink="web"
            android:linksClickable="true"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/btnRewardCodeInput" />

        <Button
            android:id="@+id/btnGenerateRewardCode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingHorizontal="32dp"
            android:paddingVertical="16dp"
            android:layout_marginTop="24dp"
            android:backgroundTint="@color/multiPlayerBackgroundLightBlackColor"
            android:text="Generate Reward Code"
            android:textColor="@color/textPrimaryWhiteColor"
            android:textSize="18sp"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvFreeRewardCodeUrl" />

        <TextView
            android:id="@+id/tvGenerateRewardCode"
            android:layout_width="match_parent"
            android:layout_height="128dp"
            android:layout_marginStart="32dp"
            android:layout_marginTop="32dp"
            android:layout_marginEnd="32dp"
            android:background="@color/multiPlayerBackgroundLightBlackColor"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:gravity="center"
            android:padding="16dp"
            android:text="코드를 생성하면 여기에 표시됩니다"
            android:textColor="@color/textPrimaryWhiteColor"
            android:textIsSelectable="true"
            android:textSize="14sp"
            app:layout_constraintBottom_toTopOf="@+id/tvRemainPoint"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</LinearLayout>
