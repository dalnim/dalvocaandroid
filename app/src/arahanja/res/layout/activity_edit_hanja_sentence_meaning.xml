<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/ViewBase"
    android:background="@color/color_recording_background"
    android:orientation="vertical">

    <com.dalread.component.Toolbar
        android:id="@id/header"
        style="@style/WidthMatch"
        app:leftIcon="@drawable/ic_back"
        app:rightText="@string/save"
        app:title="@string/title_edit_phrase" />

    <ScrollView style="@style/Match">

        <LinearLayout
            style="@style/WidthMatch"
            android:orientation="vertical"
            android:padding="10dp">
            <LinearLayout
                style="@style/WidthMatch"
                android:orientation="horizontal"
                android:padding="10dp">
                <ImageView
                    android:id="@+id/iv_web_dictionary_ch_s"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_marginEnd="10dp"
                    android:src="@drawable/ic_dic_hanja_chinese"
                    />
                <ImageView
                    android:id="@+id/iv_web_dictionary_jp"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@drawable/ic_dic_hanja_japanese"
                    />
                <TextView
                    android:id="@+id/tvVoca"
                    style="@style/Wrap"
                    android:gravity="center_horizontal"
                    android:layout_marginEnd="10dp"
                    android:layout_marginStart="10dp"
                    android:text="voca"
                    android:layout_weight="1"
                    android:textSize="20sp"
                    android:textIsSelectable="true"
                    android:textStyle="bold" />
                <ImageView
                    android:id="@+id/iv_web_dictionary_en"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_marginEnd="10dp"
                    android:src="@drawable/ic_dic_hanja_english"
                    />
                <ImageView
                    android:id="@+id/iv_web_dictionary"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_marginEnd="10dp"
                    android:src="@drawable/ic_dic_hanja_korean"/>
                <ImageView
                    android:id="@+id/ivWebSearch"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@drawable/ic_globe_empty"
                    />

            </LinearLayout>
            <LinearLayout
                style="@style/WidthMatch"
                android:layout_below="@id/tvVoca"
                android:orientation="vertical"
                android:padding="10dp">
                <TextView
                    android:id="@+id/tvVocaId"
                    style="@style/TextView_Hanja_Edit_Title"
                    android:textIsSelectable="true"
                    android:gravity="left"
                    android:text="voca id" />

                <TextView
                    android:text="@string/pronunciation"
                    style="@style/TextView_Hanja_Edit_Title" />

                <EditText
                    android:id="@+id/et_pronounce"
                    android:hint="@string/pronunciation"
                    android:paddingStart="10dp"
                    android:layout_height="30dp"
                    style="@style/TextView_Hanja_Edit" />

                <LinearLayout
                    style="@style/Match"
                    android:orientation="horizontal">

                    <LinearLayout
                        style="@style/Match"
                        android:layout_weight="1"
                        android:layout_marginRight="5dp"
                        android:orientation="vertical">
                        <TextView
                            style="@style/TextView_Hanja_Edit_Title"
                            android:text="@string/chinese" />
                        <EditText
                            android:id="@+id/etVocaChs"
                            style="@style/TextView_Hanja_Edit"
                            android:layout_height="30dp"
                            android:hint="중국어 한자" />
                        <EditText
                            android:id="@+id/etPronouncePinyin"
                            style="@style/TextView_Hanja_Edit"
                            android:layout_height="30dp"
                            android:hint="중국어 발음" />
                    </LinearLayout>
                    <LinearLayout
                        style="@style/Match"
                        android:layout_weight="1"
                        android:layout_marginLeft="5dp"
                        android:orientation="vertical">
                        <TextView
                            style="@style/TextView_Hanja_Edit_Title"

                            android:text="@string/japanese" />
                        <EditText
                            android:id="@+id/etVocaJp"
                            style="@style/TextView_Hanja_Edit"
                            android:layout_height="30dp"
                            android:hint="일본어 한자" />
                        <EditText
                            android:id="@+id/etPronounceJapanese"
                            style="@style/TextView_Hanja_Edit"
                            android:layout_height="30dp"
                            android:hint="일본어 발음" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:text="@string/meaning"
                    style="@style/TextView_Hanja_Edit_Title" />

                <EditText
                    android:id="@+id/etMeaning"
                    style="@style/TextView_Hanja_Sentence_Edit"
                    android:hint="@string/meaning" />

                <TextView
                    android:text="@string/meaning_detail"
                    style="@style/TextView_Hanja_Edit_Title" />

                <EditText
                    android:id="@+id/etDetailInfo"
                    style="@style/TextView_Hanja_Sentence_Edit"
                    android:hint="@string/meaning_detail" />

                <TextView
                    android:text="@string/meaning_eng"
                    style="@style/TextView_Hanja_Edit_Title" />

                <EditText
                    android:id="@+id/etMeaningEng"
                    style="@style/TextView_Hanja_Sentence_Edit"
                    android:hint="@string/meaning_eng" />

                <TextView
                    android:text="@string/meaning_detail_eng"
                    style="@style/TextView_Hanja_Edit_Title" />

                <EditText
                    android:id="@+id/etEngDetailInfo"
                    style="@style/TextView_Hanja_Sentence_Edit"
                    android:hint="@string/meaning_detail_eng" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
