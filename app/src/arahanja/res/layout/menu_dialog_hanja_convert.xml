<!--                android:visibility="visible"-->
<!--                android:orientation="vertical"-->
<!--                >-->

<!--                <TextView-->
<!--                    android:id="@+id/tv_sync_known"-->
<!--                    style="@style/Button_Base"-->
<!--                    android:gravity="center"-->
<!--                    android:padding="@dimen/activity_vertical_margin"-->
<!--                    android:text="To known"-->
<!--                    android:textColor="@drawable/btn_ok_color"-->
<!--                    android:textSize="16sp" />-->

<!--                <View-->
<!--                    style="@style/Divider"-->
<!--                    android:layout_marginStart="0dp" />-->
<!--            </LinearLayout>-->

            <LinearLayout
                android:id="@+id/ll_open_info_view"
                style="@style/WidthMatch"
                android:visibility="visible"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_sync_unknown"
                    style="@style/Button_Base"
                    android:gravity="center"
                    android:padding="@dimen/activity_vertical_margin"
                    android:text="Open info view"
                    android:textColor="@color/textPrimaryColor"
                    android:textSize="16sp" />

                <View
                    style="@style/Divider"
                    android:layout_marginStart="0dp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_cancel"
                style="@style/Button_Base"
                android:padding="@dimen/activity_vertical_margin"
                android:text="@string/cancel"
                android:textColor="@drawable/btn_ok_color" />

