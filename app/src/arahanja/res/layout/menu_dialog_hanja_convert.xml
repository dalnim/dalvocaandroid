                android:layout_gravity="center"
                android:layout_margin="10dp"
                android:gravity="center"
                android:text="@string/choose"
                android:textColor="@color/textPrimaryColor"
                android:textSize="16sp" />

            <View
                style="@style/Divider"
                android:layout_marginStart="0dp"
                android:background="@color/colorBorderBackgroundDialog" />

            <LinearLayout
                android:id="@+id/ll_choose_hanja"
                style="@style/WidthMatch"
                android:visibility="visible"
                android:orientation="vertical"
                >

                <TextView
                    android:id="@+id/tv_sync_known_with_server"
                    style="@style/Button_Base"
                    android:gravity="center"
                    android:padding="@dimen/activity_vertical_margin"
                    android:text="Choose Hanja"
                    android:textColor="@color/textPrimaryColor"
                    android:textSize="16sp" />

                <View
                    style="@style/Divider"
                    android:layout_marginStart="0dp" />
            </LinearLayout>


<!--            <LinearLayout-->
<!--                android:id="@+id/ll_change_to_know"-->
