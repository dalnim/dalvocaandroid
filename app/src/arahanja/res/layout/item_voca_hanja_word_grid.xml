<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/v_item"
    style="@style/ItemBase"
    android:background="@drawable/background_border_light_black_for_word_grid"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/llHanjaWordGrid"
        style="@style/Match"
        android:layout_gravity="center_horizontal"
        android:orientation="vertical">
        <com.dalread.component.CustomFontSizeTextView
            android:id="@+id/tvVoca"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="@color/textPrimaryColor"
            android:textSize="45sp"
            android:layout_gravity="center_horizontal"
            app:defaultTextSize="45sp"
            tools:text="H"/>

        <com.dalread.component.CustomFontSizeTextView
            android:id="@+id/tvMeaningPronounceHanja"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/textPrimaryColor"
            android:textSize="16sp"
            android:layout_gravity="center_horizontal"
            android:gravity="center|center_vertical"
            android:maxLines="2"
            android:lineSpacingMultiplier="1.0"
            android:layout_weight="1"
            android:layout_marginTop="0dp"
            android:layout_marginStart="3dp"
            android:layout_marginEnd="3dp"
            android:layout_marginBottom="5dp"
            app:defaultTextSize="16sp"
            tools:text="Meaning Pronounce"/>
    </LinearLayout>
</LinearLayout>
