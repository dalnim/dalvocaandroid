<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/v_item"
    style="@style/ItemBase"
    android:gravity="center_vertical"
    android:background="@color/backgroundCellColor"
    android:orientation="horizontal"
    android:paddingTop="4dp"
    android:paddingBottom="4dp">

    <LinearLayout
        style="@style/FillRemainHorizontal"
        android:layout_marginStart="20dp"
        android:orientation="vertical">

        <LinearLayout
            style="@style/WidthMatch"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvVoca"
                style="@style/Wrap"
                android:textColor="@color/textPrimaryColor"
                android:textSize="28sp"
                tools:text="Voca"/>

            <TextView
                android:id="@+id/tv_pronounce_short"
                style="@style/Wrap"
                android:layout_marginStart="16dp"
                android:textColor="@color/textPrimaryColor"
                android:textSize="16sp"
                tools:text="Pronounce"/>
        </LinearLayout>

        <TextView
            android:id="@+id/tv_pronounce_long"
            style="@style/WidthMatch"
            android:textColor="@color/textPrimaryColor"
            android:textSize="16sp"
            tools:text="Pronounce long"/>

        <TextView
            android:id="@+id/tv_meaning"
            style="@style/WidthMatch"
            android:ellipsize="end"
            android:maxLines="3"
            android:textColor="@color/textPrimaryColor"
            android:textSize="16sp"
            tools:text="Meaning"/>
    </LinearLayout>

    <ImageView
        android:id="@+id/ic_right"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:src="@drawable/ic_arrow_right_round"
        tools:ignore="ContentDescription" />
</LinearLayout>
