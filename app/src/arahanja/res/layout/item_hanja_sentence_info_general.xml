<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/WidthMatch"
    android:background="@color/BackgroundHanjaVocaInfoMain"
    android:orientation="vertical">

    <ScrollView style="@style/WidthMatch">
        <LinearLayout
            style="@style/WidthMatch"
            android:orientation="vertical">
            <LinearLayout
                style="@style/WidthMatch"
                android:orientation="horizontal">

                <LinearLayout
                    style="@style/Wrap"
                    android:orientation="vertical">
                    <ImageView
                        android:id="@+id/ivBookmark"
                        android:layout_width="50dp"
                        android:layout_height="50dp"
                        android:layout_marginTop="16dp"
                        android:layout_marginStart="16dp"
                        android:layout_marginEnd="16dp"
                        android:src="@drawable/ic_favorite_new_on"
                        />

                    <ImageView
                        android:id="@+id/ivKnow"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_margin="16dp"
                        android:gravity="center"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_voca_know_circle_notrated" />
                </LinearLayout>

                <LinearLayout
                    style="@style/WidthMatch"
                    android:layout_marginEnd="10dp"
                    android:orientation="vertical">
                    <com.dalread.component.CustomFontSizeTextView
                        android:id="@+id/tvVoca"
                        style="@style/WidthMatch"
                        android:textColor="@color/textPrimaryColor"
                        android:textSize="@dimen/hanja_text_size_in_sentence_information_view"
                        android:lineSpacingMultiplier="1"
                        app:defaultTextSize="@dimen/hanja_text_size_in_sentence_information_view"
                        tools:text="VOCA VOCA VOCA "/>

                    <com.dalread.component.CustomFontSizeTextView
                        android:id="@+id/tvPronounce"
                        style="@style/TextViewItemSelectable"
                        android:layout_width="match_parent"
                        android:layout_marginTop="2dp"
                        android:layout_marginBottom="6dp"
                        android:textSize="@dimen/hanja_pronounce_text_size_in_information_view"
                        app:defaultTextSize="@dimen/hanja_pronounce_text_size_in_information_view"
                        tools:text="PRONOUNCE"/>

                    <LinearLayout
                        android:id="@+id/llJapaneseHanja"
                        style="@style/WidthMatch"
                        android:layout_marginEnd="10dp"
                        android:orientation="horizontal">
                        <com.dalread.component.CustomFontSizeTextView
                            style="@style/TextViewItemSelectable"
                            app:defaultTextSize="@dimen/hanja_meaning_text_size_in_information_view"
                            android:layout_width="wrap_content"
                            android:layout_gravity="center"
                            android:layout_marginEnd="5dp"
                            android:textColor="@color/textPrimaryColor"
                            android:text="(日)"/>
                        <com.dalread.component.CustomFontSizeTextView
                            android:id="@+id/tvJapaneseHanja"
                            style="@style/TextViewItemSelectable"
                            app:defaultTextSize="@dimen/hanja_meaning_text_size_in_information_view"
                            android:layout_width="match_parent"
                            android:layout_gravity="center"
                            android:textColor="@color/textPrimaryColor"
                            tools:text="Japanese Hanja"/>
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/llChineseHanja"
                        style="@style/WidthMatch"
                        android:layout_marginEnd="10dp"
                        android:orientation="horizontal">
                        <com.dalread.component.CustomFontSizeTextView
                            style="@style/TextViewItemSelectable"
                            app:defaultTextSize="@dimen/hanja_meaning_text_size_in_information_view"
                            android:layout_width="wrap_content"
                            android:layout_gravity="center"
                            android:layout_marginEnd="5dp"
                            android:textColor="@color/textPrimaryColor"
                            android:text="(中)"/>
                        <com.dalread.component.CustomFontSizeTextView
                            android:id="@+id/tvChineseHanja"
                            app:defaultTextSize="@dimen/hanja_meaning_text_size_in_information_view"
                            style="@style/TextViewItemSelectable"
                            android:layout_width="match_parent"
                            android:layout_gravity="center"
                            android:textColor="@color/textPrimaryColor"
                            tools:text="Chinese Hanja"/>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                style="@style/WidthMatch"
                android:orientation="vertical"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="5dp"
                android:paddingTop="10dp"
                android:paddingBottom="10dp">

                <com.dalread.component.FuriganaView
