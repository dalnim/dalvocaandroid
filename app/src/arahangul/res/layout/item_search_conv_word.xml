<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/v_item"
    style="@style/WidthMatch"
    android:gravity="center_vertical"
    android:background="@color/backgroundColor"
    android:orientation="horizontal"
    android:paddingTop="4dp"
    android:paddingBottom="4dp">

    <LinearLayout
        style="@style/WidthMatch"
        android:orientation="vertical">

        <LinearLayout
            style="@style/WidthMatch"
            android:orientation="horizontal">
            <ImageView
                android:id="@+id/ivBookmark"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginStart="16dp"
                android:src="@drawable/ic_favorite_new_on"
                />

            <TextView
                android:id="@+id/tvVoca"
                style="@style/Wrap"
                android:textColor="@color/textPrimaryColor"
                android:textSize="28sp"
                android:lineSpacingMultiplier="1"
                android:layout_marginStart="16dp"
                tools:text="Voca"/>

            <TextView
                android:id="@+id/tv_meaning_pronounce"
                style="@style/TextViewItem"
                android:layout_width="0dp"
                android:layout_marginStart="16dp"
                android:layout_weight="1"
                android:textColor="@color/textPrimaryColor"
                tools:text="Pronounce"/>

            <ImageView
                android:id="@+id/ivKnow"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:gravity="center"
                android:src="@drawable/ic_voca_know_circle_notrated" />

        </LinearLayout>
        <TextView
            android:id="@+id/tvMeaning"
            style="@style/TextViewItem"
            android:layout_marginStart="50dp"
            android:layout_marginEnd="30dp"
            android:ellipsize="end"
            android:textColor="@color/textPrimaryColor"
            android:maxLines="1"
            android:visibility="gone"
            tools:text="Meaning"
            tools:visibility="visible"/>
    </LinearLayout>
</LinearLayout>
